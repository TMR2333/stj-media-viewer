<Page
    x:Class="StjMediaViewer.App.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppWindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="452" />
        </Grid.ColumnDefinitions>

        <!-- ============================ 左：HTML 动画演示（WebView2） ============================ -->
        <Grid Grid.Column="0" Background="#F7F7F9">
            <WebView2 x:Name="Demo" />

            <!-- WebView2 不可用时的兜底（保持引导可用） -->
            <StackPanel x:Name="DemoFallback"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" MaxWidth="420">
                <Border Width="96" Height="96"
                        CornerRadius="{ThemeResource AppRadiusXLarge}"
                        Background="{ThemeResource AppSurfaceRaisedBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7F4;" FontSize="40" Foreground="{ThemeResource AccentBrush}" />
                </Border>
                <TextBlock Text="动画演示需要 WebView2 运行时"
                           Style="{ThemeResource AppSubtitleTextStyle}"
                           Foreground="#14141A"
                           HorizontalAlignment="Center" />
                <TextBlock Text="右侧的设置依然可以正常完成。装好 Microsoft Edge WebView2 Runtime 后重新打开本页即可看到动画。"
                           Style="{ThemeResource AppCaptionTextStyle}"
                           Foreground="#6B6B75"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============================ 右：步骤与设置 ============================ -->
        <Border Grid.Column="1"
                Background="{ThemeResource AppSurfaceRaisedBrush}"
                BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource AppDividerBrush}">
            <Grid Padding="28,26,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock Text="新用户引导" Style="{ThemeResource AppMicroTextStyle}"
                               Foreground="{ThemeResource TextTertiaryBrush}" />
                    <TextBlock x:Name="StepTitle" Style="{ThemeResource AppTitleTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="StepSubtitle" Style="{ThemeResource AppCaptionTextStyle}"
                               Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,18,0,12"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <Grid>
                        <!-- 0. 欢迎 -->
                        <StackPanel x:Name="PanelWelcome" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE71D;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock Text="九维分类：类型 / 时间 / 地点 / 设备 / 主题 / 影调 / 后期 / Log / 评分"
                                           Style="{ThemeResource AppCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock Text="AI 识别可以接自己的模型，也可以完全不接"
                                           Style="{ThemeResource AppCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock Text="原片永不被修改：索引、XMP、LUT 都是附加信息"
                                           Style="{ThemeResource AppCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 1. 素材库 -->
                        <StackPanel x:Name="PanelLibrary" Spacing="12" Visibility="Collapsed">
                            <Border Style="{ThemeResource AppCardStyle}" Padding="14,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="当前素材库" Style="{ThemeResource AppMicroTextStyle}"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                    <TextBlock x:Name="LibrarySummary" Text="还没有添加素材库"
                                               Style="{ThemeResource AppBodyTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="AddFolderButton"
                                    HorizontalAlignment="Left"
                                    Click="AddFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                                    <TextBlock Text="选择素材文件夹…" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="LibraryHint"
                                       Text="扫描只读不写；删除素材只删索引。也可以点「跳过」，以后在素材库里加。"
                                       Style="{ThemeResource AppCaptionTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 2. AI 接入 -->
                        <StackPanel x:Name="PanelAi" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="BaseUrl" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBox x:Name="AiBaseUrl" PlaceholderText="https://api.openai.com/v1" />
                            <TextBlock Text="API Key（DPAPI 加密落盘，不会明文保存）"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <PasswordBox x:Name="AiKey" PlaceholderText="sk-…（可留空，以后再填）" />
                            <TextBlock Text="视觉模型" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBox x:Name="AiModel" PlaceholderText="gpt-4o-mini" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="AiTestButton" Click="AiTest_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                                        <TextBlock Text="测试连接" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="AiStatus" Style="{ThemeResource AppCaptionTextStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="不接 AI 也能用：分类、筛选、LUT、导出全部可用，只是没有自动打标。"
                                       Style="{ThemeResource AppCaptionTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 3. 偏好 -->
                        <StackPanel x:Name="PanelPrefs" Spacing="16" Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="索尼 Log 自动套官方 LUT" Style="{ThemeResource AppBodyTextStyle}" />
                                    <TextBlock Text="识别到 S-Log2 / S-Log3 / HLG 时自动匹配官方还原 LUT"
                                               Style="{ThemeResource AppCaptionTextStyle}"
                                               Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PrefLut" Grid.Column="1" OnContent="" OffContent="" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="完成后后台预热缩略图" Style="{ThemeResource AppBodyTextStyle}" />
                                    <TextBlock Text="低优先级把整库缩略图生成好，之后浏览 0ms 命中"
                                               Style="{ThemeResource AppCaptionTextStyle}"
                                               Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PrefWarmup" Grid.Column="1" OnContent="" OffContent="" />
                            </Grid>
                            <StackPanel Spacing="6">
                                <TextBlock Text="缩略图缓存上限" Style="{ThemeResource AppBodyTextStyle}" />
                                <ComboBox x:Name="PrefCache" MinWidth="200">
                                    <ComboBoxItem Content="256 MB" Tag="256" />
                                    <ComboBoxItem Content="512 MB（推荐）" Tag="512" />
                                    <ComboBoxItem Content="1024 MB" Tag="1024" />
                                    <ComboBoxItem Content="2048 MB" Tag="2048" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- 4. 完成 -->
                        <StackPanel x:Name="PanelDone" Spacing="10" Visibility="Collapsed">
                            <Border Style="{ThemeResource AppCardStyle}" Padding="14,12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="素材库" Style="{ThemeResource AppCaptionTextStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                        <TextBlock x:Name="DoneLibrary" Grid.Column="1"
                                                   Style="{ThemeResource AppCaptionTextStyle}" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="AI 接入" Style="{ThemeResource AppCaptionTextStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                        <TextBlock x:Name="DoneAi" Grid.Column="1"
                                                   Style="{ThemeResource AppCaptionTextStyle}" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="偏好" Style="{ThemeResource AppCaptionTextStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                        <TextBlock x:Name="DonePrefs" Grid.Column="1"
                                                   Style="{ThemeResource AppCaptionTextStyle}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="所有设置之后都能在「设置」里改；想再看一遍引导，设置页也有入口。"
                                       Style="{ThemeResource AppCaptionTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SkipButton" Grid.Column="0"
                            AutomationProperties.AutomationId="OnboardingSkip"
                            Style="{ThemeResource AppSubtleButtonStyle}"
                            Click="Skip_Click" Content="跳过引导" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot0" Width="6" Height="6" Fill="{ThemeResource AccentBrush}" />
                        <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="{ThemeResource TextTertiaryBrush}" Opacity="0.5" />
                        <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="{ThemeResource TextTertiaryBrush}" Opacity="0.5" />
                        <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="{ThemeResource TextTertiaryBrush}" Opacity="0.5" />
                        <Ellipse x:Name="Dot4" Width="6" Height="6" Fill="{ThemeResource TextTertiaryBrush}" Opacity="0.5" />
                    </StackPanel>

                    <Button x:Name="BackButton" Grid.Column="2"
                            AutomationProperties.AutomationId="OnboardingBack"
                            Style="{ThemeResource AppSubtleButtonStyle}"
                            Click="Back_Click" Content="上一步" IsEnabled="False" />
                    <Button x:Name="NextButton" Grid.Column="3"
                            AutomationProperties.AutomationId="OnboardingNext"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Next_Click" Content="开始" MinWidth="104" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>