<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StjMediaViewer.App.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uic="using:StjMediaViewer.App.Controls"
    xmlns:views="using:StjMediaViewer.App.Views"
    xmlns:vm="using:StjMediaViewer.App.ViewModels"
    KeyDown="OnPageKeyDown">

    <!--
        画廊视图（Apple Photos / Camera Raw 风格）：
        上方信息条 · 中间大画布（自适应缩放 + 拖拽平移）· 右侧元数据面板（可折叠）· 底部胶片带。
        只用 token 着色；画布用深色 scrim 让照片自身成为视觉主体。
    -->
    <Grid Background="{ThemeResource AppWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部信息条 ==================== -->
        <Border Grid.Row="0"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Style="{ThemeResource AppSubtleButtonStyle}" Padding="10,2,10,2" MinHeight="28"
                            Click="GalleryBack_Click" ToolTipService.ToolTip="返回素材库（Esc）">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE72B;" FontSize="{ThemeResource AppFontCaptionSize}" />
                            <TextBlock Text="素材库" Style="{ThemeResource AppCaptionTextStyle}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.InfoTitle, Mode=OneWay}"
                                   Style="{ThemeResource AppSubtitleTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.InfoSubtitle, Mode=OneWay}"
                                   Style="{ThemeResource AppMicroTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- 评分 / 色标 / 选用 状态 -->
                    <TextBlock Text="{x:Bind ViewModel.RatingText, Mode=OneWay}"
                               Style="{ThemeResource AppCaptionTextStyle}"
                               Foreground="{ThemeResource WarningBrush}"
                               VerticalAlignment="Center"
                               ToolTipService.ToolTip="数字键 0–5 评分，0 清除" />
                    <TextBlock Text="{x:Bind ViewModel.LabelText, Mode=OneWay}"
                               Style="{ThemeResource AppCaptionTextStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.PickText, Mode=OneWay}"
                               Style="{ThemeResource AppCaptionTextStyle}"
                               Foreground="{ThemeResource AccentBrush}"
                               VerticalAlignment="Center" />

                    <Border Width="1" Height="16" Background="{ThemeResource AppDividerBrush}" />

                    <TextBlock Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}"
                               Style="{ThemeResource AppMicroTextStyle}"
                               Foreground="{ThemeResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />

                    <Button Style="{ThemeResource AppIconButtonStyle}" Click="Fit_Click"
                            ToolTipService.ToolTip="适应窗口（F）">
                        <FontIcon Glyph="&#xE9A6;" FontSize="{ThemeResource AppFontCaptionSize}" />
                    </Button>
                    <Button Style="{ThemeResource AppIconButtonStyle}" Click="ActualSize_Click"
                            ToolTipService.ToolTip="实际像素 100%（1）">
                        <FontIcon Glyph="&#xE8A3;" FontSize="{ThemeResource AppFontCaptionSize}" />
                    </Button>
                    <Button Style="{ThemeResource AppIconButtonStyle}" Click="ToggleFilmstrip_Click"
                            ToolTipService.ToolTip="显示 / 隐藏胶片带（T）">
                        <FontIcon Glyph="&#xE8A9;" FontSize="{ThemeResource AppFontCaptionSize}" />
                    </Button>
                    <Button Style="{ThemeResource AppIconButtonStyle}" Click="ToggleInspector_Click"
                            ToolTipService.ToolTip="显示 / 隐藏元数据面板（I）">
                        <FontIcon Glyph="&#xE946;" FontSize="{ThemeResource AppFontCaptionSize}" />
                    </Button>
                    <Button Style="{ThemeResource AppIconButtonStyle}" Click="Transcode_Click"
                            Visibility="{x:Bind ViewModel.VideoVisibility, Mode=OneWay}"
                            ToolTipService.ToolTip="转码 / 压缩这个视频">
                        <FontIcon Glyph="&#xE8B5;" FontSize="{ThemeResource AppFontCaptionSize}" />
                    </Button>

                    <Border Background="{ThemeResource AppSurfaceAltBrush}"
                            CornerRadius="{ThemeResource AppRadiusPill}"
                            Padding="10,2">
                        <TextBlock Text="{x:Bind ViewModel.CounterText, Mode=OneWay}"
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 画布 + 元数据面板 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="CanvasHost"
                  Background="{ThemeResource AppScrimBrush}"
                  SizeChanged="CanvasHost_SizeChanged"
                  PointerWheelChanged="CanvasHost_PointerWheelChanged"
                  PointerPressed="CanvasHost_PointerPressed"
                  PointerMoved="CanvasHost_PointerMoved"
                  PointerReleased="CanvasHost_PointerReleased"
                  PointerCaptureLost="CanvasHost_PointerReleased"
                  DoubleTapped="CanvasHost_DoubleTapped">

                <ScrollViewer x:Name="CanvasScroll"
                              SizeChanged="CanvasScroll_SizeChanged"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Enabled"
                              ZoomMode="Disabled"
                              Padding="0">
                    <Image x:Name="CanvasImage"
                           Source="{x:Bind ViewModel.CurrentImage, Mode=OneWay}"
                           Stretch="Fill"
                           ImageOpened="CanvasImage_ImageOpened" />
                </ScrollViewer>

                <!-- 左右翻页 -->
                <Button x:Name="PrevButton"
                        Style="{ThemeResource AppIconButtonStyle}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Click="Prev_Click"
                        ToolTipService.ToolTip="上一张（←）">
                    <FontIcon Glyph="&#xE76B;" FontSize="{ThemeResource AppFontSubtitleSize}" />
                </Button>
                <Button x:Name="NextButton"
                        Style="{ThemeResource AppIconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Click="Next_Click"
                        ToolTipService.ToolTip="下一张（→）">
                    <FontIcon Glyph="&#xE76C;" FontSize="{ThemeResource AppFontSubtitleSize}" />
                </Button>

                <ProgressRing Width="32" Height="32"
                              IsActive="{x:Bind ViewModel.IsLoadingImage, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsLoadingImage, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                <uic:EmptyState Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                                Title="当前筛选下没有素材"
                                Description="回到素材库调整筛选条件，或先扫描一个媒体库。"
                                Glyph="&#xE8B9;"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Column="1"
                    Width="360"
                    Visibility="{x:Bind ViewModel.InspectorVisibility, Mode=OneWay}"
                    BorderBrush="{ThemeResource AppDividerBrush}"
                    BorderThickness="1,0,0,0">
                <views:InspectorPanel x:Name="Inspector" />
            </Border>
        </Grid>

        <!-- ==================== 底部胶片带 ==================== -->
        <Border Grid.Row="2"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppDividerBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{x:Bind ViewModel.FilmstripVisibility, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="12,6,12,0">
                    <TextBlock Text="胶片带" Style="{ThemeResource AppMicroTextStyle}"
                               Foreground="{ThemeResource TextTertiaryBrush}" />
                    <TextBlock HorizontalAlignment="Right"
                               Text="← / → 翻页 · 0–5 评分 · 6–9 色标 · P 选用 · X 废片 · F 适应 · 1 实际像素 · I 面板 · T 胶片带"
                               Style="{ThemeResource AppMicroTextStyle}"
                               Foreground="{ThemeResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <ListView x:Name="Filmstrip"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="Filmstrip_SelectionChanged"
                          Height="112"
                          Padding="8,4,8,8"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="3" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Margin" Value="2,0" />
                            <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusSmall}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GalleryItem">
                            <Grid Width="132" Height="86">
                                <Border Background="{ThemeResource AppSurfaceAltBrush}"
                                        CornerRadius="{ThemeResource AppRadiusSmall}"
                                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                        BorderThickness="{ThemeResource AppCardStrokeThickness}">
                                    <uic:ThumbnailImage Asset="{x:Bind Asset}" DecodeSize="220" />
                                </Border>
                                <!-- 当前项：强调描边 -->
                                <Border CornerRadius="{ThemeResource AppRadiusSmall}"
                                        BorderBrush="{ThemeResource AccentBrush}"
                                        BorderThickness="2"
                                        Visibility="{x:Bind CurrentRingVisibility, Mode=OneWay}" />
                                <uic:Badge Text="{x:Bind CodecText, Mode=OneWay}" Kind="Video"
                                           Margin="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Visibility="{x:Bind CodecVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind RatingText, Mode=OneWay}"
                                           Style="{ThemeResource AppMicroTextStyle}"
                                           Foreground="{ThemeResource WarningBrush}"
                                           Margin="4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Visibility="{x:Bind RatingVisibility, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>