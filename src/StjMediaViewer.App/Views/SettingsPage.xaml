<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StjMediaViewer.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uic="using:StjMediaViewer.App.Controls"
    xmlns:vm="using:StjMediaViewer.App.ViewModels"
    Background="{ThemeResource AppTransparentBrush}">

    <Page.Resources>
        <!-- Provider / 设计语言选择卡片：整块可点，选中态用强调色描边 -->
        <Style x:Key="ChoiceCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AppTransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource AppFontCaptionSize}" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <!-- 内容区加一层半透明表面（Glass 下 55%），保证文字不直接落在光场上（可读性优先） -->
    <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch"
                  Background="{ThemeResource AppSurfaceBrush}"
                  Padding="{ThemeResource AppPagePadding}">
        <StackPanel MaxWidth="1760" HorizontalAlignment="Left" Spacing="12">

            <!-- ============ 页头 ============ -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="设置" Style="{ThemeResource AppTitleTextStyle}" />
                    <TextBlock Text="接入你自己的视觉 / 理解模型，调整界面与工具链。所有改动会自动保存。"
                               Style="{ThemeResource AppCaptionTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SavedHint, Mode=OneWay}"
                               Style="{ThemeResource AppCaptionTextStyle}"
                               Foreground="{ThemeResource SuccessBrush}"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.SavedHintVisibility, Mode=OneWay}" />
                    <Button Style="{ThemeResource AppSubtleButtonStyle}"
                            Padding="12,2,12,2" MinHeight="28"
                            Click="SaveAll_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="{ThemeResource AppFontCaptionSize}" />
                            <TextBlock Text="全部保存" Style="{ThemeResource AppCaptionTextStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 演示模式提示 -->
            <Border Background="{ThemeResource WarningSubtleBrush}"
                    BorderBrush="{ThemeResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource AppRadiusMedium}"
                    Padding="12,8"
                    Visibility="{x:Bind ViewModel.DemoVisibility, Mode=OneWay}">
                <StackPanel Spacing="2">
                    <TextBlock Text="当前处于演示模式" Style="{ThemeResource AppCaptionTextStyle}"
                               Foreground="{ThemeResource WarningBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.DemoReason, Mode=OneWay}"
                               Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ==================================================================
                 AI 接入
                 ================================================================== -->
            <uic:SectionCard Header="AI 接入" Subtitle="OpenAI 兼容协议：OpenAI / Azure OpenAI / Ollama / 任意自建网关" Glyph="&#xE9D2;">
                <StackPanel Spacing="12">

                    <!-- Provider 预设 -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource ChoiceCardStyle}" Tag="openai" Click="Provider_Click">
                            <Grid>
                                <Border Background="{ThemeResource AppSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource AppCardStrokeBrush}" BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                        CornerRadius="{ThemeResource AppRadiusMedium}" />
                                <Border BorderBrush="{ThemeResource AppSelectedBorderBrush}" BorderThickness="2"
                                        CornerRadius="{ThemeResource AppRadiusMedium}"
                                        Visibility="{x:Bind ViewModel.OpenAiSelectedVisibility, Mode=OneWay}" />
                                <StackPanel Margin="12,10" Spacing="3">
                                    <TextBlock Text="OpenAI" Style="{ThemeResource AppBodyTextStyle}"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="官方 API · gpt-4o-mini" Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource ChoiceCardStyle}" Tag="azure-openai" Click="Provider_Click">
                            <Grid>
                                <Border Background="{ThemeResource AppSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource AppCardStrokeBrush}" BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                        CornerRadius="{ThemeResource AppRadiusMedium}" />
                                <Border BorderBrush="{ThemeResource AppSelectedBorderBrush}" BorderThickness="2"
                                        CornerRadius="{ThemeResource AppRadiusMedium}"
                                        Visibility="{x:Bind ViewModel.AzureSelectedVisibility, Mode=OneWay}" />
                                <StackPanel Margin="12,10" Spacing="3">
                                    <TextBlock Text="Azure OpenAI" Style="{ThemeResource AppBodyTextStyle}"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="企业部署 · deployment 路径" Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource ChoiceCardStyle}" Tag="ollama" Click="Provider_Click">
                            <Grid>
                                <Border Background="{ThemeResource AppSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource AppCardStrokeBrush}" BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                        CornerRadius="{ThemeResource AppRadiusMedium}" />
                                <Border BorderBrush="{ThemeResource AppSelectedBorderBrush}" BorderThickness="2"
                                        CornerRadius="{ThemeResource AppRadiusMedium}"
                                        Visibility="{x:Bind ViewModel.OllamaSelectedVisibility, Mode=OneWay}" />
                                <StackPanel Margin="12,10" Spacing="3">
                                    <TextBlock Text="Ollama" Style="{ThemeResource AppBodyTextStyle}"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="本地运行 · llava / qwen2-vl" Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource ChoiceCardStyle}" Tag="custom" Click="Provider_Click">
                            <Grid>
                                <Border Background="{ThemeResource AppSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource AppCardStrokeBrush}" BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                        CornerRadius="{ThemeResource AppRadiusMedium}" />
                                <Border BorderBrush="{ThemeResource AppSelectedBorderBrush}" BorderThickness="2"
                                        CornerRadius="{ThemeResource AppRadiusMedium}"
                                        Visibility="{x:Bind ViewModel.CustomSelectedVisibility, Mode=OneWay}" />
                                <StackPanel Margin="12,10" Spacing="3">
                                    <TextBlock Text="自定义网关" Style="{ThemeResource AppBodyTextStyle}"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="OpenAI 兼容自建服务" Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- BaseUrl + API Key -->
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="104" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="BaseUrl" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 PlaceholderText="https://api.openai.com/v1"
                                 Text="{x:Bind ViewModel.BaseUrl, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key" Style="{StaticResource FieldLabelStyle}" />
                        <PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1"
                                     PasswordChanged="ApiKeyBox_PasswordChanged"
                                     PlaceholderText="sk-… / Azure 的 api-key（本地 Ollama 随便填）" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{x:Bind ViewModel.KeyStatusText, Mode=OneWay}"
                                   Style="{ThemeResource AppMicroTextStyle}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="视觉模型" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 PlaceholderText="gpt-4o-mini / mock-vision-1 / llava"
                                 Text="{x:Bind ViewModel.VisionModel, Mode=TwoWay}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="文本模型" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 PlaceholderText="可选：不填则复用视觉模型"
                                 Text="{x:Bind ViewModel.TextModel, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Text="本地 Mock 服务：BaseUrl 填 http://127.0.0.1:8787/v1、模型填 mock-vision-1 即可跑通视觉分类全链路。"
                               Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" />

                    <!-- 测试连接 -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="TestButton"
                                Background="{ThemeResource AccentSubtleBrush}"
                                BorderBrush="{ThemeResource AccentBorderBrush}"
                                Style="{ThemeResource AppSubtleButtonStyle}"
                                Padding="12,2,12,2" MinHeight="30"
                                Click="TestConnection_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D4;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="{x:Bind ViewModel.TestButtonText, Mode=OneWay}" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                        <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}"
                                      Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.TestStatus, Mode=OneWay}"
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   Foreground="{ThemeResource SuccessBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.TestSuccessVisibility, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TestErrorText, Mode=OneWay}"
                               Style="{ThemeResource AppCaptionTextStyle}"
                               Foreground="{ThemeResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.TestErrorVisibility, Mode=OneWay}" />

                    <!-- 高级参数 -->
                    <Expander Header="高级参数与提示词" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10" Margin="0,6,0,0">
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="并发数" Style="{ThemeResource AppMicroTextStyle}" />
                                    <NumberBox Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline"
                                               Value="{x:Bind ViewModel.Concurrency, Mode=OneWay}"
                                               ValueChanged="Concurrency_ValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="超时（秒）" Style="{ThemeResource AppMicroTextStyle}" />
                                    <NumberBox Minimum="5" Maximum="600" SpinButtonPlacementMode="Inline"
                                               Value="{x:Bind ViewModel.TimeoutSeconds, Mode=OneWay}"
                                               ValueChanged="Timeout_ValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="图片最大边长（px）" Style="{ThemeResource AppMicroTextStyle}" />
                                    <NumberBox Minimum="256" Maximum="4096" SpinButtonPlacementMode="Inline"
                                               Value="{x:Bind ViewModel.MaxImageDimension, Mode=OneWay}"
                                               ValueChanged="MaxImageDimension_ValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="JPEG 质量" Style="{ThemeResource AppMicroTextStyle}" />
                                    <NumberBox Minimum="30" Maximum="100" SpinButtonPlacementMode="Inline"
                                               Value="{x:Bind ViewModel.JpegQuality, Mode=OneWay}"
                                               ValueChanged="JpegQuality_ValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="每日调用上限（0 = 不限）" Style="{ThemeResource AppMicroTextStyle}" />
                                    <NumberBox Minimum="0" Maximum="100000" SpinButtonPlacementMode="Inline"
                                               Value="{x:Bind ViewModel.DailyCallLimit, Mode=OneWay}"
                                               ValueChanged="DailyLimit_ValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8" VerticalAlignment="Bottom">
                                    <ToggleSwitch Header="请求 JSON Schema" IsOn="{x:Bind ViewModel.UseJsonSchema, Mode=TwoWay}" />
                                    <ToggleSwitch Header="DryRun（不发网络，验证流程）" IsOn="{x:Bind ViewModel.DryRun, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="自定义提示词（留空使用内置中文提示词）" Style="{ThemeResource AppMicroTextStyle}" />
                            <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="92"
                                     PlaceholderText="可选：覆盖默认分类提示词…"
                                     Text="{x:Bind ViewModel.CustomPrompt, Mode=TwoWay}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </uic:SectionCard>

            <!-- ==================================================================
                 外观
                 ================================================================== -->
            <uic:SectionCard Header="外观" Subtitle="当前使用微软 Fluent 设计语言；支持跟随系统 / 浅色 / 深色" Glyph="&#xE790;">
                <StackPanel Spacing="12">
                    <Border Background="{ThemeResource AppSurfaceAltBrush}"
                            BorderBrush="{ThemeResource AppCardStrokeBrush}"
                            BorderThickness="{ThemeResource AppCardStrokeThickness}"
                            CornerRadius="{ThemeResource AppRadiusMedium}"
                            Padding="12,10">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B9;" FontSize="{ThemeResource AppFontBodySize}"
                                          Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock Text="Fluent Design" Style="{ThemeResource AppBodyTextStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <Border Background="{ThemeResource AccentSubtleBrush}"
                                        BorderBrush="{ThemeResource AccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{ThemeResource AppRadiusPill}"
                                        Padding="8,1" VerticalAlignment="Center">
                                    <TextBlock Text="当前" Style="{ThemeResource AppMicroTextStyle}"
                                               Foreground="{ThemeResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="微软原生设计语言：Mica 背板、Segoe UI Variable 字阶、细描边、键盘友好的焦点视觉。"
                                       Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="明暗模式" Style="{StaticResource FieldLabelStyle}" MinWidth="104" />
                        <ComboBox x:Name="ThemeModeBox" MinWidth="180" SelectionChanged="ThemeMode_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </uic:SectionCard>

            <!-- ==================================================================
                 媒体库
                 ================================================================== -->
            <uic:SectionCard Header="媒体库" Subtitle="扫描本机目录并建立索引；移除只删索引，不动磁盘文件" Glyph="&#xE8B7;">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Background="{ThemeResource AccentSubtleBrush}"
                                BorderBrush="{ThemeResource AccentBorderBrush}"
                                Style="{ThemeResource AppSubtleButtonStyle}"
                                Padding="12,2,12,2" MinHeight="30"
                                Click="AddLibrary_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F4;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="添加媒体库" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LibrarySummary, Mode=OneWay}"
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   VerticalAlignment="Center" Margin="12,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLibraryBusy, Mode=OneWay}"
                                          Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.LibraryBusyText, Mode=OneWay}"
                                       Style="{ThemeResource AppMicroTextStyle}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryItemViewModel">
                                <Border Background="{ThemeResource AppSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                        BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                        CornerRadius="{ThemeResource AppRadiusMedium}"
                                        Padding="12,8" Margin="0,0,0,6">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;"
                                                  FontSize="{ThemeResource AppFontBodySize}"
                                                  Foreground="{ThemeResource AccentBrush}"
                                                  VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource AppCaptionTextStyle}"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Path}" Style="{ThemeResource AppMicroTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind CountText}" Style="{ThemeResource AppCaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind LastScanText}" Style="{ThemeResource AppMicroTextStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Button Style="{ThemeResource AppIconButtonStyle}" Click="RescanLibrary_Click"
                                                    ToolTipService.ToolTip="重新扫描">
                                                <FontIcon Glyph="&#xE895;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                            </Button>
                                            <Button Style="{ThemeResource AppIconButtonStyle}" Click="RelocateLibrary_Click"
                                                    ToolTipService.ToolTip="重新定位（目录被删除 / 移动 / 改名后用它修复）">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                            </Button>
                                            <Button Style="{ThemeResource AppIconButtonStyle}" Click="PurgeLibrary_Click"
                                                    ToolTipService.ToolTip="清理失效记录">
                                                <FontIcon Glyph="&#xE74D;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                            </Button>
                                            <Button Style="{ThemeResource AppIconButtonStyle}" Click="RemoveLibrary_Click"
                                                    ToolTipService.ToolTip="移除（不删文件）">
                                                <FontIcon Glyph="&#xE74D;" FontSize="{ThemeResource AppFontCaptionSize}"
                                                          Foreground="{ThemeResource DangerBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="还没有添加媒体库。点「添加媒体库」选择文件夹后会递归扫描并建立索引。"
                               Style="{ThemeResource AppCaptionTextStyle}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.LibraryEmptyVisibility, Mode=OneWay}" />
                </StackPanel>
            </uic:SectionCard>

            <!-- ==================================================================
                 工具链
                 ================================================================== -->
            <uic:SectionCard Header="工具链与缓存" Subtitle="ffmpeg 用于视频抽帧与代理；城市库用于离线反查 GPS" Glyph="&#xE90F;">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="ffmpeg 路径" Style="{ThemeResource AppMicroTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" PlaceholderText="留空自动探测（程序目录 / tools/ffmpeg/bin / PATH）"
                                     Text="{x:Bind ViewModel.FfmpegPath, Mode=TwoWay}" />
                            <Button Grid.Column="1" Style="{ThemeResource AppSubtleButtonStyle}"
                                    Padding="12,2,12,2" MinHeight="30" Click="ReloadFfmpeg_Click">
                                <TextBlock Text="重新探测" Style="{ThemeResource AppCaptionTextStyle}" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.FfmpegStatus, Mode=OneWay}"
                                   Style="{ThemeResource AppMicroTextStyle}"
                                   Foreground="{ThemeResource SuccessBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.FfmpegOkVisibility, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.FfmpegStatus, Mode=OneWay}"
                                   Style="{ThemeResource AppMicroTextStyle}"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.FfmpegMissingVisibility, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="离线城市库" Style="{ThemeResource AppMicroTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.GeocoderStatus, Mode=OneWay}"
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CacheText, Mode=OneWay}"
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ProgressRing Grid.Column="1" Width="18" Height="18"
                                      IsActive="{x:Bind ViewModel.IsClearingCache, Mode=OneWay}"
                                      Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{ThemeResource AppSubtleButtonStyle}"
                                Padding="12,2,12,2" MinHeight="30" Click="ClearCache_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="清空缓存" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 缓存位置 + 自动清理 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="缓存位置" Style="{ThemeResource AppMicroTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     PlaceholderText="留空 = %LOCALAPPDATA%\StjMediaViewer\Cache"
                                     Text="{x:Bind ViewModel.CachePath, Mode=TwoWay}" />
                            <Button Grid.Column="1" Style="{ThemeResource AppSubtleButtonStyle}"
                                    Padding="12,2,12,2" MinHeight="30" Click="PickCacheFolder_Click">
                                <TextBlock Text="浏览…" Style="{ThemeResource AppCaptionTextStyle}" />
                            </Button>
                            <Button Grid.Column="2" Style="{ThemeResource AppSubtleButtonStyle}"
                                    Padding="12,2,12,2" MinHeight="30" Click="ResetCacheFolder_Click">
                                <TextBlock Text="恢复默认" Style="{ThemeResource AppCaptionTextStyle}" />
                            </Button>
                        </Grid>
                        <TextBlock Text="换位置后缩略图会重新生成；旧缓存留在原目录，可手动删除，不会自动搬。"
                                   Style="{ThemeResource AppMicroTextStyle}"
                                   Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="体积上限 (MB)" Style="{ThemeResource AppMicroTextStyle}" />
                                <NumberBox Value="{x:Bind ViewModel.CacheLimitMb, Mode=TwoWay}" Minimum="64" Maximum="65536"
                                           SmallChange="64" SpinButtonPlacementMode="Compact" Width="130" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="保留天数（0 = 不限）" Style="{ThemeResource AppMicroTextStyle}" />
                                <NumberBox Value="{x:Bind ViewModel.CacheMaxAgeDays, Mode=TwoWay}" Minimum="0" Maximum="3650"
                                           SmallChange="7" SpinButtonPlacementMode="Compact" Width="150" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="检查间隔（小时）" Style="{ThemeResource AppMicroTextStyle}" />
                                <NumberBox Value="{x:Bind ViewModel.CacheCleanIntervalHours, Mode=TwoWay}" Minimum="1" Maximum="168"
                                           SmallChange="1" SpinButtonPlacementMode="Compact" Width="140" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Bottom">
                                <ToggleSwitch Header="自动清理" IsOn="{x:Bind ViewModel.CacheAutoClean, Mode=TwoWay}" MinWidth="0" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CacheCleanStatus, Mode=OneWay}"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Style="{ThemeResource AppSubtleButtonStyle}"
                                    Padding="12,2,12,2" MinHeight="30" Click="CleanCacheNow_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                    <TextBlock Text="立即清理" Style="{ThemeResource AppCaptionTextStyle}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="自动清理在启动后约 20 秒跑一次，之后每 30 分钟检查、到间隔才真正执行；只删缓存目录里的缩略图，不动素材。"
                                   Style="{ThemeResource AppMicroTextStyle}"
                                   Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 后台全库预热：低并发把整库缩略图生成并落盘，之后滚动都走 0ms 缓存命中 -->
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.WarmupText, Mode=OneWay}"
                                       Style="{ThemeResource AppCaptionTextStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Style="{ThemeResource AppSubtleButtonStyle}"
                                    AutomationProperties.AutomationId="WarmupButton"
                                    Padding="12,2,12,2" MinHeight="30" Click="Warmup_Click"
                                    ToolTipService.ToolTip="后台低优先级生成整库缩略图（可随时停止，下次继续）">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                    <TextBlock Text="{x:Bind ViewModel.WarmupButtonText, Mode=OneWay}"
                                               Style="{ThemeResource AppCaptionTextStyle}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ProgressBar Value="{x:Bind ViewModel.WarmupProgress, Mode=OneWay}"
                                     Maximum="100"
                                     Height="4"
                                     Visibility="{x:Bind ViewModel.WarmupProgressVisibility, Mode=OneWay}" />
                        <TextBlock Style="{ThemeResource AppMicroTextStyle}"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="预热只生成缩略图，不改素材；第二次打开或滚回已预热区间都是 0ms 命中。" />
                    </StackPanel>
                </StackPanel>
            </uic:SectionCard>

            <!-- ==================================================================
                 关于
                 ================================================================== -->
            <uic:SectionCard Header="关于" Subtitle="版本、路径与开源致谢" Glyph="&#xE946;">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneWay}"
                               Style="{ThemeResource AppSubtitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.RuntimeSummary, Mode=OneWay}"
                               Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" />

                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="设置文件" Style="{ThemeResource AppMicroTextStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SettingsPath, Mode=OneWay}"
                                   Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="数据目录" Style="{ThemeResource AppMicroTextStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.AppDataPath, Mode=OneWay}"
                                   Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{ThemeResource AppSubtleButtonStyle}" Padding="12,2,12,2" MinHeight="30"
                                Click="OpenLogFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE838;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="打开日志目录" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                            <Button Style="{ThemeResource AppSubtleButtonStyle}"
                                    Padding="12,2,12,2" MinHeight="30" Click="ReplayOnboarding_Click"
                                    ToolTipService.ToolTip="重新看一遍功能演示，并可重设关键选项">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE81E;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                    <TextBlock Text="重新播放新用户引导" Style="{ThemeResource AppCaptionTextStyle}" />
                                </StackPanel>
                            </Button>
                        <Button Style="{ThemeResource AppSubtleButtonStyle}" Padding="12,2,12,2" MinHeight="30"
                                Click="OpenSettingsFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="打开数据目录" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="开源致谢" Style="{ThemeResource AppSectionHeaderTextStyle}" />
                    <TextBlock Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap"
                               Text="MetadataExtractor（Apache-2.0）· FFmpeg（LGPL/GPL，按发行版许可）· GeoNames 城市数据（CC BY 4.0）· Microsoft.WindowsAppSDK / WinUI 3（MIT）· CommunityToolkit.Mvvm（MIT）· Microsoft.Data.Sqlite（MIT）。界面遵循微软 Fluent Design 公开规范。" />
                    <TextBlock Text="素材本身不会被上传；只有你主动点击 AI 分类时，压缩后的预览图才会发送到你配置的模型端点。"
                               Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </uic:SectionCard>

            <!-- 底部留白 -->
            <Border Height="12" Background="{ThemeResource AppTransparentBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>