<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="StjMediaViewer.App.Views.TranscodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="转码 / 压缩"
    PrimaryButtonText="开始转码"
    CloseButtonText="关闭"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick">

    <Grid Width="620" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 源信息 -->
        <Border Grid.Row="0"
                Background="{ThemeResource AppSurfaceAltBrush}"
                BorderBrush="{ThemeResource AppCardStrokeBrush}"
                BorderThickness="{ThemeResource AppCardStrokeThickness}"
                CornerRadius="{ThemeResource AppRadiusMedium}"
                Padding="12,10">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SourceTitle" Style="{ThemeResource AppBodyTextStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SourceInfo" Grid.Row="1" Style="{ThemeResource AppMicroTextStyle}"
                           Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 预设 -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="转码预设" Style="{ThemeResource AppCaptionTextStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
            <ComboBox x:Name="ProfileBox" HorizontalAlignment="Stretch" SelectionChanged="OnProfileChanged" />
            <TextBlock x:Name="ProfileDescription" Style="{ThemeResource AppMicroTextStyle}"
                       Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 参数 -->
        <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="分辨率" Style="{ThemeResource AppCaptionTextStyle}" VerticalAlignment="Center" />
            <ComboBox x:Name="ResolutionBox" Grid.Column="1" SelectionChanged="OnOptionChanged">
                <ComboBoxItem Content="保持原分辨率" Tag="0" />
                <ComboBoxItem Content="4K (2160p)" Tag="2160" />
                <ComboBoxItem Content="1080p" Tag="1080" />
                <ComboBoxItem Content="720p" Tag="720" />
                <ComboBoxItem Content="480p" Tag="480" />
            </ComboBox>

            <TextBlock Grid.Column="2" Text="编码器" Style="{ThemeResource AppCaptionTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox x:Name="EncoderBox" Grid.Column="3" SelectionChanged="OnOptionChanged">
                <ComboBoxItem Content="H.265 / HEVC" Tag="h265" />
                <ComboBoxItem Content="H.264 / AVC" Tag="h264" />
                <ComboBoxItem Content="AV1" Tag="av1" />
                <ComboBoxItem Content="不重编码（仅换容器）" Tag="copy" />
            </ComboBox>

            <TextBlock Grid.Row="1" Text="质量 CRF" Style="{ThemeResource AppCaptionTextStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Slider x:Name="CrfSlider" Minimum="16" Maximum="36" StepFrequency="1" Value="28"
                        ValueChanged="OnCrfChanged" Width="200" />
                <TextBlock x:Name="CrfValue" Style="{ThemeResource AppCaptionTextStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="速度" Style="{ThemeResource AppCaptionTextStyle}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox x:Name="SpeedBox" Grid.Row="1" Grid.Column="3" SelectionChanged="OnOptionChanged">
                <ComboBoxItem Content="更快（体积略大）" Tag="veryfast" />
                <ComboBoxItem Content="均衡" Tag="medium" />
                <ComboBoxItem Content="更慢（同画质更小）" Tag="slow" />
            </ComboBox>

            <TextBlock Grid.Row="2" Text="硬件加速" Style="{ThemeResource AppCaptionTextStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ToggleSwitch x:Name="HardwareSwitch" IsOn="True" MinWidth="0" Toggled="OnOptionChanged" />
                <TextBlock x:Name="EncoderHint" Style="{ThemeResource AppMicroTextStyle}"
                           Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 输出 -->
        <Border Grid.Row="3"
                Background="{ThemeResource AppSurfaceAltBrush}"
                CornerRadius="{ThemeResource AppRadiusMedium}" Padding="12,8">
            <StackPanel Spacing="4">
                <TextBlock x:Name="OutputPathText" Style="{ThemeResource AppMicroTextStyle}"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="EstimateText" Style="{ThemeResource AppMicroTextStyle}"
                           Foreground="{ThemeResource TextTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 进度 / 结果 -->
        <StackPanel Grid.Row="4" Spacing="6">
            <ProgressBar x:Name="Progress" Value="0" Maximum="100" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Style="{ThemeResource AppMicroTextStyle}"
                       Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <StackPanel x:Name="ResultActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <Button x:Name="OpenFolderButton" Content="打开所在文件夹" Click="OnOpenFolder" />
                <Button x:Name="AgainButton" Content="再转一次" Click="OnAgain" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>