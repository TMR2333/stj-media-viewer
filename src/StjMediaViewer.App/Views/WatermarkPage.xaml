<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StjMediaViewer.App.Views.WatermarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uic="using:StjMediaViewer.App.Controls"
    xmlns:vm="using:StjMediaViewer.App.ViewModels"
    Background="{ThemeResource AppSurfaceBrush}">

    <!--
        水印工作台：把 Watermark Studio 网页的品牌水印搬进桌面端。
        布局：左侧预览（拖入照片），右侧品牌 / 预设 / 调节 / 导出。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 页头（品牌 logo + 标题 + 操作） ============ -->
        <Border Grid.Row="0"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16,24,14">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="ms-appx:///Assets/Watermark/logo.png"
                       Height="24" Stretch="Uniform" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="水印工作台" Style="{ThemeResource AppTitleTextStyle}" />
                    <TextBlock Text="品牌字标水印 · 拖入照片即可预览，导出保留原始尺寸；本地处理，不上传任何文件"
                               Style="{ThemeResource AppCaptionTextStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{ThemeResource AppSubtleButtonStyle}" Click="PickFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="{ThemeResource AppFontCaptionSize}" />
                            <TextBlock Text="选择图片" Style="{ThemeResource AppCaptionTextStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{ThemeResource AppSubtleButtonStyle}" Click="UseSelection_Click"
                            ToolTipService.ToolTip="用素材库里当前选中的照片">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B9;" FontSize="{ThemeResource AppFontCaptionSize}" />
                            <TextBlock Text="用当前选中" Style="{ThemeResource AppCaptionTextStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{ThemeResource AppSubtleButtonStyle}" Click="BatchExport_Click"
                            ToolTipService.ToolTip="把素材库选中的照片批量加水印导出到文件夹">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B5;" FontSize="{ThemeResource AppFontCaptionSize}" />
                            <TextBlock Text="批量导出" Style="{ThemeResource AppCaptionTextStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Background="{ThemeResource AccentSubtleBrush}"
                            BorderBrush="{ThemeResource AccentBorderBrush}"
                            Style="{ThemeResource AppSubtleButtonStyle}"
                            Click="Export_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="{ThemeResource AppFontCaptionSize}" />
                            <TextBlock Text="导出水印图" Style="{ThemeResource AppCaptionTextStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 工作区 ============ -->
        <Grid Grid.Row="1" Padding="24,16,24,20" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 预览 -->
            <Border Grid.Column="0"
                    Background="{ThemeResource AppSurfaceAltBrush}"
                    BorderBrush="{ThemeResource AppCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource AppRadiusLarge}"
                    AllowDrop="True"
                    DragOver="Preview_DragOver"
                    Drop="Preview_Drop">
                <Grid>
                    <Image Source="{x:Bind ViewModel.Preview, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.PreviewVisibility, Mode=OneWay}"
                           Stretch="Uniform"
                           Margin="16" />

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE91B;" FontSize="{ThemeResource AppFontDisplaySize}"
                                  Foreground="{ThemeResource TextTertiaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="把照片拖到这里" Style="{ThemeResource AppSubtitleTextStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="支持 JPG / PNG / WEBP / TIFF / HEIC（与网页版一致的品牌水印）"
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <ProgressRing Width="36" Height="36" IsActive="True"
                                  Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 控制面板 -->
            <ScrollViewer Grid.Column="1" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <!-- 文件信息 -->
                    <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                            BorderBrush="{ThemeResource AppCardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource AppRadiusMedium}"
                            Padding="14,10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.SourceName, Mode=OneWay}"
                                       Style="{ThemeResource AppCaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.SourceDetail, Mode=OneWay}"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- 品牌 -->
                    <uic:SectionCard Header="水印品牌" Subtitle="五个品牌字标（含你原来网页里的 STJARNA 主标）">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Brands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WatermarkBrandOption">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource AppRadiusSmall}"
                                            Padding="10,6"
                                            Click="Brand_Click"
                                            Tag="{x:Bind Brand}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{x:Bind Preview}" Height="26"
                                                   Stretch="Uniform" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                                       Style="{ThemeResource AppCaptionTextStyle}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </uic:SectionCard>

                    <!-- 预设 + 墨色 -->
                    <uic:SectionCard Header="风格预设" Subtitle="经典 / 柔淡 / 暗调 / 胶片 / 白框 / 黑框">
                        <StackPanel Spacing="10">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WatermarkPresetOption">
                                        <Button Style="{ThemeResource AppSubtleButtonStyle}"
                                                Padding="10,3,10,3" MinHeight="28"
                                                Click="Preset_Click" Tag="{x:Bind Preset}">
                                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource AppMicroTextStyle}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Spacing="4">
                                <TextBlock Text="墨色" Style="{ThemeResource AppMicroTextStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Inks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WatermarkInkOption">
                                            <Button Style="{ThemeResource AppSubtleButtonStyle}"
                                                    Padding="10,3,10,3" MinHeight="28"
                                                    Click="Ink_Click" Tag="{x:Bind Ink}">
                                                <TextBlock Text="{x:Bind Name}" Style="{ThemeResource AppMicroTextStyle}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </uic:SectionCard>

                    <!-- 调节 -->
                    <uic:SectionCard Header="调节" Subtitle="水印宽度、透明度与垂直位置">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="水印大小" Style="{ThemeResource AppMicroTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SizeText, Mode=OneWay}"
                                               Style="{ThemeResource AppMicroTextStyle}"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="3" Maximum="40" StepFrequency="1"
                                        Value="{x:Bind ViewModel.SizePercent, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="透明度" Style="{ThemeResource AppMicroTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.OpacityText, Mode=OneWay}"
                                               Style="{ThemeResource AppMicroTextStyle}"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="10" Maximum="100" StepFrequency="1"
                                        Value="{x:Bind ViewModel.OpacityPercent, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="垂直位置" Style="{ThemeResource AppMicroTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                                               Style="{ThemeResource AppMicroTextStyle}"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{x:Bind ViewModel.PositionPercent, Mode=TwoWay}" />
                            </StackPanel>

                            <ToggleSwitch Header="投影" OnContent="开" OffContent="关"
                                          IsOn="{x:Bind ViewModel.Shadow, Mode=TwoWay}" />
                        </StackPanel>
                    </uic:SectionCard>

                    <!-- 导出 -->
                    <uic:SectionCard Header="导出" Subtitle="保留原始像素尺寸；文件写入本地">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox Width="130" Header="格式"
                                          ItemsSource="{x:Bind ViewModel.Formats}"
                                          DisplayMemberPath="Name"
                                          SelectedIndex="0"
                                          SelectionChanged="Format_SelectionChanged" />
                                <ComboBox Width="170" Header="质量"
                                          ItemsSource="{x:Bind ViewModel.QualityOptions}"
                                          SelectedIndex="{x:Bind ViewModel.QualityIndex, Mode=TwoWay}" />
                            </StackPanel>

                            <Button HorizontalAlignment="Stretch"
                                    Background="{ThemeResource AccentSubtleBrush}"
                                    BorderBrush="{ThemeResource AccentBorderBrush}"
                                    Style="{ThemeResource AppSubtleButtonStyle}"
                                    Click="Export_Click" MinHeight="34">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                    <TextBlock Text="导出水印图" Style="{ThemeResource AppCaptionTextStyle}" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.ExportPathText, Mode=OneWay}"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource SuccessBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </uic:SectionCard>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>