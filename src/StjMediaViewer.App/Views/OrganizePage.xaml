<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StjMediaViewer.App.Views.OrganizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StjMediaViewer.App.ViewModels"
    Background="{ThemeResource AppTransparentBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Border Grid.Row="0"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10,16,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1">
                    <TextBlock Text="整理" Style="{ThemeResource AppSubtitleTextStyle}" />
                    <TextBlock Text="按设备 / 年份 / 城市 / 主题等分类，把磁盘上和云端目录里的真实文件移动进对应文件夹。"
                               Style="{ThemeResource AppCaptionTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="预览计划" Click="Preview_Click" Style="{ThemeResource AppSubtleButtonStyle}" />
                    <Button Content="执行整理" Click="Execute_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="找回未转移的 XMP" Click="RepairXmp_Click" Style="{ThemeResource AppSubtleButtonStyle}"
                            ToolTipService.ToolTip="扫描媒体库里孤立的 .xmp（主文件已被转移走），按文件名复制到素材现在的位置" />
                    <Button Content="撤销上次整理" Click="Undo_Click" Style="{ThemeResource AppSubtleButtonStyle}"
                            Visibility="{x:Bind ViewModel.UndoVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch" Padding="24,18,24,28">
            <StackPanel x:Name="PageContent" Spacing="12" MaxWidth="1760" HorizontalAlignment="Left">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromHorizontalOffset="24" FromVerticalOffset="0" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- 来源 -->
                <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="{ThemeResource AppCardStrokeThickness}"
                        CornerRadius="{ThemeResource AppRadiusMedium}" Padding="16,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="从哪里整理" Style="{ThemeResource AppBodyTextStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Width="360" HorizontalAlignment="Left"
                                      ItemsSource="{x:Bind ViewModel.Sources, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.SelectedSourceIndex, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OrganizeSourceOption">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SourceDetail, Mode=OneWay}"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       MaxWidth="620" />
                        </Grid>
                        <TextBlock Text="本地媒体库：移动硬盘上的真实文件；云端目标：直接整理云端目录（需要先同步过一次，索引里才有元数据）。"
                                   Style="{ThemeResource AppMicroTextStyle}"
                                   Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 分类规则 -->
                <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="{ThemeResource AppCardStrokeThickness}"
                        CornerRadius="{ThemeResource AppRadiusMedium}" Padding="16,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="按什么分类" Style="{ThemeResource AppBodyTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="一级目录" Style="{ThemeResource AppMicroTextStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                                <ComboBox Width="200" ItemsSource="{x:Bind ViewModel.DimensionChoices, Mode=OneWay}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedPrimaryIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="二级目录（可选）" Style="{ThemeResource AppMicroTextStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                                <ComboBox Width="200" ItemsSource="{x:Bind ViewModel.SecondaryChoices, Mode=OneWay}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedSecondaryIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="三级目录（可选）" Style="{ThemeResource AppMicroTextStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                                <ComboBox Width="200" ItemsSource="{x:Bind ViewModel.TertiaryChoices, Mode=OneWay}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedTertiaryIndex, Mode=TwoWay}"
                                          ToolTipService.ToolTip="例：设备 / 年份 / 月份 三级；同一维度重复选只保留一层" />
                            </StackPanel>
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CustomDimensionVisibility, Mode=OneWay}">
                                <TextBlock Text="自定义类别维度" Style="{ThemeResource AppMicroTextStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBox Width="180" Text="{x:Bind ViewModel.CustomDimension, Mode=TwoWay}"
                                         PlaceholderText="项目 / 客户 / 场地" />
                            </StackPanel>
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.GeoOptionsVisibility, Mode=OneWay}">
                                <TextBlock Text="一个范围" Style="{ThemeResource AppMicroTextStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                                <ComboBox Width="170" SelectedIndex="{x:Bind ViewModel.GeoRadiusIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="200 米" />
                                    <ComboBoxItem Content="500 米（推荐）" />
                                    <ComboBoxItem Content="1 公里" />
                                    <ComboBoxItem Content="2 公里" />
                                    <ComboBoxItem Content="5 公里" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="重名处理" Style="{ThemeResource AppMicroTextStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                                <ComboBox Width="170" SelectedIndex="{x:Bind ViewModel.SelectedConflictIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="重名加序号（推荐）" />
                                    <ComboBoxItem Content="跳过已存在的" />
                                    <ComboBoxItem Content="覆盖目标文件" />
                                </ComboBox>
                            </StackPanel>
                            <ToggleSwitch Header="删除空的原文件夹"
                                          OnContent="删" OffContent="留"
                                          IsOn="{x:Bind ViewModel.DeleteEmptySourceFolders, Mode=TwoWay}"
                                          ToolTipService.ToolTip="转移完成后，源文件夹如果已经完全空了就删掉；里面还有任何文件（包括没整理的媒体）就保留" />
                        </StackPanel>

                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.LocalOptionsVisibility, Mode=OneWay}">
                            <TextBlock Text="目标根目录（本地）" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.RootPath, Mode=TwoWay}"
                                     PlaceholderText="留空 / 默认 = 每个文件仍留在自己的媒体库根目录下" Width="720"
                                     HorizontalAlignment="Left" />
                        </StackPanel>

                        <TextBlock Text="示例：一级「拍摄设备」+ 二级「拍摄年份」+ 三级「拍摄月份」 → D:\照片\Sony A7 IV\2024\05\DSC01234.jpg；同一维度重复选只保留一层，边车 .xmp 跟着主文件一起移动。"
                                   Style="{ThemeResource AppMicroTextStyle}"
                                   Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 状态 -->
                <InfoBar IsOpen="{x:Bind ViewModel.IsWarningOpen, Mode=OneWay}"
                         Severity="Warning" IsClosable="False"
                         Message="{x:Bind ViewModel.WarningText, Mode=OneWay}" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{ThemeResource AppCaptionTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{ThemeResource AppCaptionTextStyle}"
                               Foreground="{ThemeResource TextTertiaryBrush}" />
                </StackPanel>
                <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100"
                             Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />

                <!-- 预览 -->
                <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="{ThemeResource AppCardStrokeThickness}"
                        CornerRadius="{ThemeResource AppRadiusMedium}" Padding="8"
                        Visibility="{x:Bind ViewModel.PreviewVisibility, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <Grid Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="原路径" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="整理后" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="2" Text="说明" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" Margin="12,0,8,0" />
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.PreviewRows, Mode=OneWay}"
                                  SelectionMode="None" MaxHeight="520">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:OrganizePreviewRow">
                                    <Grid ColumnSpacing="12" Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Source, Mode=OneWay}"
                                                   Style="{ThemeResource AppMicroTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Target, Mode=OneWay}"
                                                   Style="{ThemeResource AppMicroTextStyle}"
                                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Note, Mode=OneWay}"
                                                   Style="{ThemeResource AppMicroTextStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>