<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StjMediaViewer.App.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uic="using:StjMediaViewer.App.Controls"
    xmlns:vm="using:StjMediaViewer.App.ViewModels"
    Background="{ThemeResource AppTransparentBrush}">

    <!--
        导入页：外部存储设备 → 导入计划（JPG 预览 + RAW 配对）→ 执行与报告 → 目录级核验。
        设计语言：单一 Fluent；颜色 / 字号 / 圆角全部来自 ThemeResource token。
    -->
    <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Left"
                  Background="{ThemeResource AppSurfaceBrush}"
                  Padding="{ThemeResource AppPagePadding}">
        <StackPanel MaxWidth="1080" MinWidth="1032" HorizontalAlignment="Left" Spacing="12">

            <!-- 页头 -->
            <StackPanel Spacing="2" Margin="0,0,0,4">
                <TextBlock Text="导入" Style="{ThemeResource AppTitleTextStyle}" />
                <TextBlock Text="读取 U 盘 / SD 卡 / 相机：JPG 当预览、RAW 自动配对，导入后逐文件核验；页尾的「导出核验」可对任意两棵目录树做哈希对账。"
                           Style="{ThemeResource AppCaptionTextStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- ================= ① 设备区 ================= -->
            <uic:SectionCard Header="外部存储设备"
                             Subtitle="插入 U 盘 / SD 卡 / 相机后点刷新；也可以直接浏览任意文件夹"
                             Glyph="&#xE88E;">
                <StackPanel Spacing="12">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.DeviceSummaryText, Mode=OneWay}"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.HiddenInternalText, Mode=OneWay}"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.HiddenInternalVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{ThemeResource AppSubtleButtonStyle}"
                                Padding="12,2,12,2" MinHeight="30"
                                Click="RefreshDevices_Click"
                                ToolTipService.ToolTip="重新枚举存储设备">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="刷新" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ProgressRing Width="28" Height="28"
                                  IsActive="{x:Bind ViewModel.IsLoadingDevices, Mode=OneWay}"
                                  Foreground="{ThemeResource AccentBrush}"
                                  Visibility="{x:Bind ViewModel.DeviceRingVisibility, Mode=OneWay}" />

                    <uic:EmptyState Glyph="&#xE88E;"
                                    Title="没有检测到存储设备"
                                    Description="{x:Bind ViewModel.DeviceEmptyDescription, Mode=OneWay}"
                                    ActionText="重新枚举"
                                    ActionInvoked="RefreshDevices_Action"
                                    Visibility="{x:Bind ViewModel.DeviceEmptyVisibility, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.DeviceListVisibility, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="248"
                                               MinColumnSpacing="12"
                                               MinRowSpacing="12"
                                               MaximumRowsOrColumns="3"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImportDeviceCard">
                                <Border Background="{ThemeResource AppSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource AppStrokeBrush}"
                                        BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                        CornerRadius="{ThemeResource AppCardRadius}"
                                        Padding="{ThemeResource AppCardPadding}"
                                        MinHeight="170">
                                    <StackPanel Spacing="8">

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="{x:Bind TitleText}"
                                                           Style="{ThemeResource AppSubtitleTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind RootPathText}"
                                                               Style="{ThemeResource AppCaptionTextStyle}" />
                                                    <TextBlock Text="{x:Bind SourceText}"
                                                               Style="{ThemeResource AppMicroTextStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource AppSurfaceBrush}"
                                                    BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                                    BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                                    CornerRadius="{ThemeResource AppRadiusPill}"
                                                    Padding="8,1"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{x:Bind TypeText}"
                                                           Style="{ThemeResource AppMicroTextStyle}" />
                                            </Border>
                                        </Grid>

                                        <ProgressBar Minimum="0" Maximum="100"
                                                     Value="{x:Bind UsedPercent}"
                                                     Foreground="{ThemeResource AccentBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind CapacityText}"
                                                       Style="{ThemeResource AppMicroTextStyle}" />
                                            <TextBlock Text="{x:Bind FreeText}"
                                                       Style="{ThemeResource AppMicroTextStyle}" />
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind CameraText}"
                                                   Style="{ThemeResource AppMicroTextStyle}"
                                                   Foreground="{ThemeResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind CameraVisibility}" />
                                        <TextBlock Text="介质未就绪：请插入存储卡 / U 盘"
                                                   Style="{ThemeResource AppMicroTextStyle}"
                                                   Foreground="{ThemeResource DangerBrush}"
                                                   Visibility="{x:Bind NotReadyVisibility}" />

                                        <Button HorizontalAlignment="Stretch"
                                                Background="{ThemeResource AccentSubtleBrush}"
                                                BorderBrush="{ThemeResource AccentBorderBrush}"
                                                Style="{ThemeResource AppSubtleButtonStyle}"
                                                Padding="12,2,12,2" MinHeight="32"
                                                IsEnabled="{x:Bind ScanEnabled}"
                                                CommandParameter="{x:Bind}"
                                                Click="ScanDevice_Click"
                                                ToolTipService.ToolTip="扫描该设备并生成导入计划">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE721;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                                <TextBlock Text="扫描并导入" Style="{ThemeResource AppCaptionTextStyle}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="或者："
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   VerticalAlignment="Center" />
                        <Button Style="{ThemeResource AppSubtleButtonStyle}"
                                Padding="12,2,12,2" MinHeight="30"
                                Click="BrowseFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="浏览任意文件夹…" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </uic:SectionCard>

            <!-- ================= ② 导入计划区 ================= -->
            <uic:SectionCard Header="导入计划"
                             Subtitle="JPG 作为预览，配对的 RAW 与边车一起导入"
                             Glyph="&#xE8B5;"
                             Visibility="{x:Bind ViewModel.PlanVisibility, Mode=OneWay}">
                <StackPanel Spacing="10">

                    <TextBlock Text="{x:Bind ViewModel.PlanSourceText, Mode=OneWay}"
                               Style="{ThemeResource AppMicroTextStyle}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- 统计条 -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.PlanStatText, Mode=OneWay}"
                                       Style="{ThemeResource AppSubtitleTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DuplicateHintText, Mode=OneWay}"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource WarningBrush}"
                                       Visibility="{x:Bind ViewModel.DuplicateHintVisibility, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.WarningsText, Mode=OneWay}"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.WarningsVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.SelectedCountText, Mode=OneWay}"
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 扫描进度 -->
                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ViewModel.PlanProgressVisibility, Mode=OneWay}">
                        <ProgressBar Minimum="0" Maximum="100"
                                     Value="{x:Bind ViewModel.PlanPercent, Mode=OneWay}"
                                     Foreground="{ThemeResource AccentBrush}"
                                     IsIndeterminate="{x:Bind ViewModel.IsScanningPlan, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16"
                                          IsActive="{x:Bind ViewModel.IsScanningPlan, Mode=OneWay}"
                                          Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PlanStatusText, Mode=OneWay}"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 分组工具条 -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.PlanGroupsVisibility, Mode=OneWay}">
                        <Button Style="{ThemeResource AppSubtleButtonStyle}" Padding="10,1,10,1" MinHeight="28"
                                Click="SelectAll_Click">
                            <TextBlock Text="全选" Style="{ThemeResource AppCaptionTextStyle}" />
                        </Button>
                        <Button Style="{ThemeResource AppSubtleButtonStyle}" Padding="10,1,10,1" MinHeight="28"
                                Click="SelectNone_Click">
                            <TextBlock Text="全不选" Style="{ThemeResource AppCaptionTextStyle}" />
                        </Button>
                        <Button Style="{ThemeResource AppSubtleButtonStyle}" Padding="10,1,10,1" MinHeight="28"
                                Click="SelectPairs_Click">
                            <TextBlock Text="只选 RAW+JPEG 成对" Style="{ThemeResource AppCaptionTextStyle}" />
                        </Button>
                        <Button Style="{ThemeResource AppSubtleButtonStyle}" Padding="10,1,10,1" MinHeight="28"
                                Click="SelectRawOnly_Click">
                            <TextBlock Text="只选 RAW 单张" Style="{ThemeResource AppCaptionTextStyle}" />
                        </Button>
                    </StackPanel>

                    <!-- 分组列表（虚拟化） -->
                    <ListView ItemsSource="{x:Bind ViewModel.PlanGroups, Mode=OneWay}"
                              SelectionMode="None"
                              MaxHeight="440"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind ViewModel.PlanGroupsVisibility, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImportGroupRow">
                                <Border Background="{ThemeResource AppSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                        BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                        CornerRadius="{ThemeResource AppRadiusMedium}"
                                        Padding="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="48" Height="48"
                                                Background="{ThemeResource AppSurfaceBrush}"
                                                BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                                BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                                CornerRadius="{ThemeResource AppRadiusSmall}">
                                            <Grid>
                                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                                                <FontIcon Glyph="&#xE722;"
                                                          FontSize="{ThemeResource AppFontTitleSize}"
                                                          Foreground="{ThemeResource TextTertiaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind FileNameText}"
                                                           Style="{ThemeResource AppCaptionTextStyle}"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <uic:Badge Text="RAW&amp;JPEG" Kind="Raw"
                                                           VerticalAlignment="Center"
                                                           Visibility="{x:Bind PairVisibility}" />
                                                <uic:Badge Text="RAW 单张" Kind="Neutral"
                                                           VerticalAlignment="Center"
                                                           Visibility="{x:Bind RawOnlyVisibility}" />
                                                <TextBlock Text="{x:Bind CameraText}"
                                                           Style="{ThemeResource AppMicroTextStyle}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{x:Bind CameraVisibility}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind CapturedText}"
                                                           Style="{ThemeResource AppMicroTextStyle}" />
                                                <TextBlock Text="{x:Bind DetailText}"
                                                           Style="{ThemeResource AppMicroTextStyle}" />
                                                <TextBlock Text="{x:Bind RawText}"
                                                           Style="{ThemeResource AppMicroTextStyle}"
                                                           Foreground="{ThemeResource AccentBrush}"
                                                           Visibility="{x:Bind RawTextVisibility}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="勾选后参与本次导入" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <uic:EmptyState Glyph="&#xE7C5;"
                                    Title="{x:Bind ViewModel.PlanEmptyTitle, Mode=OneWay}"
                                    Description="{x:Bind ViewModel.PlanEmptyDescription, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.PlanEmptyVisibility, Mode=OneWay}" />
                </StackPanel>
            </uic:SectionCard>

            <!-- ================= ③ 设置区（Expander 默认展开） ================= -->
            <Border Style="{ThemeResource AppCardStyle}">
                <Expander IsExpanded="True"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <FontIcon Glyph="&#xE713;" FontSize="{ThemeResource AppFontBodySize}"
                                      Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="导入设置" Style="{ThemeResource AppSubtitleTextStyle}" />
                                <TextBlock Text="目标目录 / 子目录模板 / 复制与核验选项"
                                           Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Margin="0,4,0,0">

                        <!-- 目标目录 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="目标目录" Style="{ThemeResource AppMicroTextStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         IsReadOnly="True"
                                         Text="{x:Bind ViewModel.DestinationRoot, Mode=OneWay}"
                                         PlaceholderText="选择导入目标目录" />
                                <Button Grid.Column="1"
                                        Style="{ThemeResource AppSubtleButtonStyle}"
                                        Padding="12,2,12,2" MinHeight="30"
                                        Click="ChangeDestination_Click">
                                    <TextBlock Text="更改…" Style="{ThemeResource AppCaptionTextStyle}" />
                                </Button>
                            </Grid>
                            <TextBlock Text="默认使用当前媒体库根目录；导入的文件按下面的模板建子目录。"
                                       Style="{ThemeResource AppMicroTextStyle}" />
                        </StackPanel>

                        <!-- 子目录模板 -->
                        <StackPanel Spacing="4" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="子目录模板" Style="{ThemeResource AppMicroTextStyle}" />
                            <ComboBox x:Name="TemplateBox"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0"
                                      SelectionChanged="TemplateBox_SelectionChanged">
                                <ComboBoxItem Content="{}{yyyy}/{yyyy-MM-dd}（按天，推荐）" Tag="{}{yyyy}/{yyyy-MM-dd}" />
                                <ComboBoxItem Content="{}{yyyy}/{MM}（按月）" Tag="{}{yyyy}/{MM}" />
                                <ComboBoxItem Content="{}{yyyy}/{country}/{city}（按国家 / 城市）" Tag="{}{yyyy}/{country}/{city}" />
                                <ComboBoxItem Content="不建子目录（直接放根目录）" Tag="" />
                            </ComboBox>
                        </StackPanel>

                        <!-- 开关区 -->
                        <Grid ColumnSpacing="24" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleSwitch Grid.Row="0" Grid.Column="0"
                                          Header="复制（不移动源文件）"
                                          IsOn="{x:Bind ViewModel.CopyInsteadOfMove, Mode=TwoWay}" />
                            <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                          Header="同时导入边车（.xmp 等）"
                                          IsOn="{x:Bind ViewModel.IncludeSidecars, Mode=TwoWay}" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="0"
                                          Header="跳过已存在的同名文件"
                                          IsOn="{x:Bind ViewModel.SkipExisting, Mode=TwoWay}" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                          Header="导入后核验（严格 SHA-256）"
                                          IsOn="{x:Bind ViewModel.VerifyAfterCopy, Mode=TwoWay}" />
                            <ToggleSwitch Grid.Row="2" Grid.Column="0"
                                          Header="严格核验（关 = 大小 + 首尾指纹）"
                                          IsOn="{x:Bind ViewModel.StrictVerify, Mode=TwoWay}" />
                            <ToggleSwitch Grid.Row="2" Grid.Column="1"
                                          Header="导入后登记进媒体库"
                                          IsOn="{x:Bind ViewModel.IndexAfterCopy, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Background="{ThemeResource AccentSubtleBrush}"
                                    BorderBrush="{ThemeResource AccentBorderBrush}"
                                    Style="{ThemeResource AppSubtleButtonStyle}"
                                    Padding="14,2,14,2" MinHeight="32"
                                    IsEnabled="{x:Bind ViewModel.CanStartImport, Mode=OneWay}"
                                    Click="StartImport_Click"
                                    Visibility="{x:Bind ViewModel.StartImportVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                    <TextBlock Text="开始导入" Style="{ThemeResource AppCaptionTextStyle}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{ThemeResource AppSubtleButtonStyle}"
                                    Padding="14,2,14,2" MinHeight="32"
                                    Click="CancelImport_Click"
                                    Visibility="{x:Bind ViewModel.CancelImportVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE711;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                    <TextBlock Text="取消" Style="{ThemeResource AppCaptionTextStyle}" />
                                </StackPanel>
                            </Button>
                            <ProgressRing Width="20" Height="20"
                                          IsActive="{x:Bind ViewModel.IsImporting, Mode=OneWay}"
                                          Foreground="{ThemeResource AccentBrush}"
                                          VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ================= ④ 执行进度 ================= -->
            <uic:SectionCard Header="导入进度"
                             Subtitle="复制 → 核验 → 登记，逐组推进"
                             Glyph="&#xE9D9;"
                             Visibility="{x:Bind ViewModel.ImportProgressVisibility, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{x:Bind ViewModel.ImportPercent, Mode=OneWay}"
                                 Foreground="{ThemeResource AccentBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ImportStatusText, Mode=OneWay}"
                               Style="{ThemeResource AppBodyTextStyle}"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ImportCurrentFile, Mode=OneWay}"
                               Style="{ThemeResource AppMicroTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <Button Style="{ThemeResource AppSubtleButtonStyle}"
                            Padding="12,2,12,2" MinHeight="30"
                            HorizontalAlignment="Left"
                            Click="CancelImport_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="{ThemeResource AppFontCaptionSize}" />
                            <TextBlock Text="取消导入" Style="{ThemeResource AppCaptionTextStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </uic:SectionCard>

            <!-- ================= ④ 报告 ================= -->
            <uic:SectionCard Header="导入报告"
                             Subtitle="组 / 文件 / 核验结果"
                             Glyph="&#xE9D5;"
                             Visibility="{x:Bind ViewModel.ReportVisibility, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="{ThemeResource AppFontBodySize}"
                                  Foreground="{ThemeResource SuccessBrush}"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind ViewModel.ReportSuccessVisibility, Mode=OneWay}" />
                        <FontIcon Glyph="&#xEA39;" FontSize="{ThemeResource AppFontBodySize}"
                                  Foreground="{ThemeResource DangerBrush}"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind ViewModel.ReportDangerVisibility, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.ReportTitleText, Mode=OneWay}"
                                   Style="{ThemeResource AppSubtitleTextStyle}"
                                   Foreground="{ThemeResource SuccessBrush}"
                                   Visibility="{x:Bind ViewModel.ReportSuccessVisibility, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.ReportTitleText, Mode=OneWay}"
                                   Style="{ThemeResource AppSubtitleTextStyle}"
                                   Foreground="{ThemeResource DangerBrush}"
                                   Visibility="{x:Bind ViewModel.ReportDangerVisibility, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.ReportSummaryText, Mode=OneWay}"
                               Style="{ThemeResource AppBodyTextStyle}"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ReportStatsText, Mode=OneWay}"
                               Style="{ThemeResource AppCaptionTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ReportVerifyText, Mode=OneWay}"
                               Style="{ThemeResource AppCaptionTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ReportElapsedText, Mode=OneWay}"
                               Style="{ThemeResource AppMicroTextStyle}" />

                    <Expander Header="失败 / 异常项"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Visibility="{x:Bind ViewModel.ReportFailedVisibility, Mode=OneWay}">
                        <ScrollViewer MaxHeight="240" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ReportFailedItems, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ImportReportItemRow">
                                        <Grid ColumnSpacing="8" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind StatusText}"
                                                       Style="{ThemeResource AppMicroTextStyle}"
                                                       Foreground="{ThemeResource DangerBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind VerifyText}"
                                                       Style="{ThemeResource AppMicroTextStyle}" />
                                            <StackPanel Grid.Column="2" Spacing="1">
                                                <TextBlock Text="{x:Bind FileNameText}"
                                                           Style="{ThemeResource AppCaptionTextStyle}"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind DetailText}"
                                                           Style="{ThemeResource AppMicroTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Expander>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{ThemeResource AppSubtleButtonStyle}"
                                Padding="12,2,12,2" MinHeight="30"
                                Click="OpenDestination_Click"
                                IsEnabled="{x:Bind ViewModel.CanOpenDestination, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE838;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="打开目标目录" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{ThemeResource AppSubtleButtonStyle}"
                                Padding="12,2,12,2" MinHeight="30"
                                Click="BatchEdit_Click"
                                Visibility="{x:Bind ViewModel.BatchEditVisibility, Mode=OneWay}"
                                ToolTipService.ToolTip="为这批刚导入的素材批量填写日期 / 城市 / 分类">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="填写这批文件的信息" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{ThemeResource AppSubtleButtonStyle}"
                                Padding="12,2,12,2" MinHeight="30"
                                Click="Reimport_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="再导入一次" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </uic:SectionCard>

            <!-- ================= ⑤ 核验导出区 ================= -->
            <uic:SectionCard Header="导出核验"
                             Subtitle="确认导出没有损坏、没有漏导"
                             Glyph="&#xE73E;">
                <StackPanel Spacing="12">

                    <TextBlock Style="{ThemeResource AppCaptionTextStyle}" TextWrapping="Wrap"
                               Text="核验内容 = 逐文件哈希比对（严格模式 SHA-256 / 快速模式 大小+首尾指纹）+ 源目录文件数对账，用于确认导出没有损坏、没有漏导。" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="源目录" Style="{ThemeResource AppMicroTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" IsReadOnly="True"
                                     Text="{x:Bind ViewModel.VerifySourceRoot, Mode=OneWay}"
                                     PlaceholderText="选择导出前的源目录" />
                            <Button Grid.Column="1"
                                    Style="{ThemeResource AppSubtleButtonStyle}"
                                    Padding="12,2,12,2" MinHeight="30"
                                    Click="VerifySource_Click">
                                <TextBlock Text="选择…" Style="{ThemeResource AppCaptionTextStyle}" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="目标目录" Style="{ThemeResource AppMicroTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" IsReadOnly="True"
                                     Text="{x:Bind ViewModel.VerifyDestinationRoot, Mode=OneWay}"
                                     PlaceholderText="选择导出后的目标目录" />
                            <Button Grid.Column="1"
                                    Style="{ThemeResource AppSubtleButtonStyle}"
                                    Padding="12,2,12,2" MinHeight="30"
                                    Click="VerifyDestination_Click">
                                <TextBlock Text="选择…" Style="{ThemeResource AppCaptionTextStyle}" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <ToggleSwitch Header="严格核验（SHA-256）"
                                      IsOn="{x:Bind ViewModel.VerifyStrictMode, Mode=TwoWay}" />
                        <Button Background="{ThemeResource AccentSubtleBrush}"
                                BorderBrush="{ThemeResource AccentBorderBrush}"
                                Style="{ThemeResource AppSubtleButtonStyle}"
                                Padding="14,2,14,2" MinHeight="32"
                                VerticalAlignment="Bottom"
                                Click="StartVerify_Click"
                                Visibility="{x:Bind ViewModel.StartVerifyVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="开始核验" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{ThemeResource AppSubtleButtonStyle}"
                                Padding="14,2,14,2" MinHeight="32"
                                VerticalAlignment="Bottom"
                                Click="CancelVerify_Click"
                                Visibility="{x:Bind ViewModel.CancelVerifyVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="{ThemeResource AppFontCaptionSize}" />
                                <TextBlock Text="取消" Style="{ThemeResource AppCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                        <ProgressRing Width="20" Height="20"
                                      IsActive="{x:Bind ViewModel.IsVerifying, Mode=OneWay}"
                                      Foreground="{ThemeResource AccentBrush}"
                                      VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ViewModel.VerifyProgressVisibility, Mode=OneWay}">
                        <ProgressBar IsIndeterminate="True"
                                     Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.VerifyStatusText, Mode=OneWay}"
                                   Style="{ThemeResource AppMicroTextStyle}" />
                    </StackPanel>

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.VerifyReportVisibility, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.VerifyResultTitle, Mode=OneWay}"
                                   Style="{ThemeResource AppSubtitleTextStyle}"
                                   Foreground="{ThemeResource SuccessBrush}"
                                   Visibility="{x:Bind ViewModel.VerifySuccessVisibility, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.VerifyResultTitle, Mode=OneWay}"
                                   Style="{ThemeResource AppSubtitleTextStyle}"
                                   Foreground="{ThemeResource DangerBrush}"
                                   Visibility="{x:Bind ViewModel.VerifyDangerVisibility, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.VerifySummaryText, Mode=OneWay}"
                                   Style="{ThemeResource AppBodyTextStyle}"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.VerifyDetailText, Mode=OneWay}"
                                   Style="{ThemeResource AppMicroTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.VerifyIssueCountText, Mode=OneWay}"
                                   Style="{ThemeResource AppMicroTextStyle}" />

                        <ScrollViewer MaxHeight="260" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                                      Visibility="{x:Bind ViewModel.VerifyIssuesVisibility, Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.VerifyIssues, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VerifyIssueRow">
                                        <Grid ColumnSpacing="8" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind StatusText}"
                                                       Style="{ThemeResource AppMicroTextStyle}"
                                                       Foreground="{ThemeResource DangerBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{x:Bind FileNameText}"
                                                           Style="{ThemeResource AppCaptionTextStyle}"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind DetailText}"
                                                           Style="{ThemeResource AppMicroTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </uic:SectionCard>

            <Border Height="12" Background="{ThemeResource AppTransparentBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>