<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StjMediaViewer.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uic="using:StjMediaViewer.App.Controls"
    Background="{ThemeResource AppTransparentBrush}">

    <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Left"
                  Background="{ThemeResource AppSurfaceBrush}"
                  Padding="{ThemeResource AppPagePadding}">
        <StackPanel MaxWidth="1060" MinWidth="1012" HorizontalAlignment="Left" Spacing="16">

            <!-- ============ 品牌区 ============ -->
            <Border Background="{ThemeResource AppSurfaceAltBrush}"
                    BorderBrush="{ThemeResource AppCardStrokeBrush}"
                    BorderThickness="{ThemeResource AppCardStrokeThickness}"
                    CornerRadius="{ThemeResource AppRadiusLarge}"
                    Padding="28,24">
                <StackPanel Spacing="18" HorizontalAlignment="Center">
                    <!-- 应用图标（暗色版：金色线稿，适合深色卡片） -->
                    <Image Source="ms-appx:///Assets/AppIcon/icon-light-compact.png"
                           Width="96" Height="96"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" />

                    <!-- LOGO（黑底白字，原图自带留白，这里只做等比缩放 + 圆角裁切） -->
                    <Border Background="#0A0A0C"
                            CornerRadius="{ThemeResource AppRadiusMedium}"
                            Padding="28,14"
                            HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/About/logo.png"
                               Height="72"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Stjarna PERSPECTIVE 出品"
                                   Style="{ThemeResource AppTitleTextStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="co-worked with DeepSeek Harness"
                                   Style="{ThemeResource AppBodyTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="stj-media-viewer · 面向专业创作者的素材整理与画廊工作流"
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 版本 / 环境 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                                BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                CornerRadius="{ThemeResource AppRadiusSmall}"
                                Padding="10,3">
                            <TextBlock x:Name="VersionText" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                        <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                                BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                CornerRadius="{ThemeResource AppRadiusSmall}"
                                Padding="10,3">
                            <TextBlock x:Name="RuntimeText" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                        <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                                BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                CornerRadius="{ThemeResource AppRadiusSmall}"
                                Padding="10,3">
                            <TextBlock x:Name="BuildText" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 表情包 ============ -->
            <Border Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppCardStrokeBrush}"
                    BorderThickness="{ThemeResource AppCardStrokeThickness}"
                    CornerRadius="{ThemeResource AppRadiusLarge}"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="项目表情包" Style="{ThemeResource AppSectionHeaderTextStyle}" />
                        <TextBlock Text="开发过程中的真实精神状态，共四张（随仓库一起分发）。"
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                            <Border CornerRadius="{ThemeResource AppRadiusMedium}">
                                <Image Source="ms-appx:///Assets/About/meme-dsh.png" Stretch="Uniform"
                                       Height="200" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="「你目录里的 dsh 是什么…大烧货吗？」"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                            <Border CornerRadius="{ThemeResource AppRadiusMedium}">
                                <Image Source="ms-appx:///Assets/About/meme-model.png" Stretch="Uniform"
                                       Height="200" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="「好模型」"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                            <Border CornerRadius="{ThemeResource AppRadiusMedium}">
                                <Image Source="ms-appx:///Assets/About/meme-xiong.png" Stretch="Uniform"
                                       Height="200" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="「大师，这个『凶』是什么意思啊？」"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <Border CornerRadius="{ThemeResource AppRadiusMedium}">
                                <Image Source="ms-appx:///Assets/About/meme-quiet.png" Stretch="Uniform"
                                       Height="200" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="「嘘——先把它能跑通」"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 技术栈 / 许可 ============ -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="{ThemeResource AppCardStrokeThickness}"
                        CornerRadius="{ThemeResource AppRadiusLarge}"
                        Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="构建于" Style="{ThemeResource AppSectionHeaderTextStyle}" />
                        <ItemsControl x:Name="StackItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="{ThemeResource AppCardStrokeThickness}"
                        CornerRadius="{ThemeResource AppRadiusLarge}"
                        Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="关于这个项目" Style="{ThemeResource AppSectionHeaderTextStyle}" />
                        <TextBlock Style="{ThemeResource AppCaptionTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="stj-media-viewer 是一个 Windows 原生（WinUI 3）素材管理工具：递归扫描媒体库、解析元数据、按九个维度自动 / 人工 / AI 分类，提供画廊视图、时间线、重复项、导入核验、转码压缩与云同步。" />
                        <TextBlock Style="{ThemeResource AppCaptionTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="第三方组件：MetadataExtractor（Apache-2.0）、FFmpeg（LGPL/GPL，外部可执行）、GeoNames 城市数据（CC BY 4.0）、Microsoft.WindowsAppSDK / WinUI 3（MIT）、CommunityToolkit.Mvvm（MIT）、Microsoft.Data.Sqlite（MIT）。" />
                        <TextBlock x:Name="CopyrightText"
                                   Style="{ThemeResource AppMicroTextStyle}"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Stjarna PERSPECTIVE · co-worked with DeepSeek Harness"
                       Style="{ThemeResource AppMicroTextStyle}"
                       Foreground="{ThemeResource TextTertiaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>