<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StjMediaViewer.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uic="using:StjMediaViewer.App.Controls"
    Background="{ThemeResource AppTransparentBrush}">

    <ScrollViewer x:Name="PageScroll" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch"
                  Background="{ThemeResource AppSurfaceBrush}"
                  Padding="{ThemeResource AppPagePadding}">
        <StackPanel x:Name="PageContent" HorizontalAlignment="Left" Spacing="16">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromHorizontalOffset="24" FromVerticalOffset="0" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

            <!-- ============ 品牌区 ============ -->
            <Border Background="{ThemeResource AppSurfaceAltBrush}"
                    BorderBrush="{ThemeResource AppCardStrokeBrush}"
                    BorderThickness="{ThemeResource AppCardStrokeThickness}"
                    CornerRadius="{ThemeResource AppRadiusLarge}"
                    Padding="28,24">
                <StackPanel Spacing="18" HorizontalAlignment="Center">
                    <!-- 应用图标（暗色版：金色线稿，适合深色卡片） -->
                    <Image Source="ms-appx:///Assets/AppIcon/icon-light-compact.png"
                           Width="96" Height="96"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" />

                    <!-- LOGO（黑底白字，原图自带留白，这里只做等比缩放 + 圆角裁切） -->
                    <Border Background="#0A0A0C"
                            CornerRadius="{ThemeResource AppRadiusMedium}"
                            Padding="28,14"
                            HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/About/logo.png"
                               Height="72"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Stjarna PERSPECTIVE 出品"
                                   Style="{ThemeResource AppTitleTextStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="co-worked with DeepSeek Harness"
                                   Style="{ThemeResource AppBodyTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="stj-media-viewer · 面向专业创作者的素材整理与画廊工作流"
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 版本 / 环境 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                                BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                CornerRadius="{ThemeResource AppRadiusSmall}"
                                Padding="10,3">
                            <TextBlock x:Name="VersionText" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                        <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                                BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                CornerRadius="{ThemeResource AppRadiusSmall}"
                                Padding="10,3">
                            <TextBlock x:Name="RuntimeText" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                        <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                                BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                CornerRadius="{ThemeResource AppRadiusSmall}"
                                Padding="10,3">
                            <TextBlock x:Name="BuildText" Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 作者 ============ -->
            <Border Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppCardStrokeBrush}"
                    BorderThickness="{ThemeResource AppCardStrokeThickness}"
                    CornerRadius="{ThemeResource AppRadiusLarge}"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="作者" Style="{ThemeResource AppSectionHeaderTextStyle}" />
                        <TextBlock Text="这个项目是两个人（和一个模型）互相鞭策出来的。"
                                   Style="{ThemeResource AppCaptionTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- TMR：点整行打开 B 站主页 -->
                    <Button x:Name="TmrAuthorButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,8"
                            Click="TmrAuthor_Click"
                            ToolTipService.ToolTip="打开 TMR 的 B 站主页">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="56" Height="56" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="ms-appx:///Assets/About/author-tmr.jpg" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="TMR" Style="{ThemeResource AppSubtitleTextStyle}" />
                                <TextBlock Text="不会开发，只会鞭策大肥鱼"
                                           Style="{ThemeResource AppCaptionTextStyle}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="space.bilibili.com/632568585"
                                           Style="{ThemeResource AppMicroTextStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="{ThemeResource AppFontCaptionSize}"
                                      Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="10,0" />

                    <!-- 一个货成：点整行打开抖音主页 -->
                    <Button x:Name="HuoChengAuthorButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,8"
                            Click="HuoChengAuthor_Click"
                            ToolTipService.ToolTip="打开「一个货成」的抖音主页">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="56" Height="56" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="ms-appx:///Assets/About/author-huocheng.png" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="一个货成" Style="{ThemeResource AppSubtitleTextStyle}" />
                                <TextBlock Text="Stjarna PERSPECTIVE 组织社长、参与开发水印功能"
                                           Style="{ThemeResource AppCaptionTextStyle}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="www.douyin.com/user/MS4wLjABAAAAaAohr1ln9GMhbZ21KSG3KvdbMPMfW_d5mXkZvSfRUDY"
                                           Style="{ThemeResource AppMicroTextStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="{ThemeResource AppFontCaptionSize}"
                                      Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="10,0" />

                    <!-- 一只马子：点整行打开 B 站主页 -->
                    <Button x:Name="MaZiAuthorButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,8"
                            Click="MaZiAuthor_Click"
                            ToolTipService.ToolTip="打开「一只马子」的 B 站主页">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="56" Height="56" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="ms-appx:///Assets/About/author-mazi.png" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="一只马子" Style="{ThemeResource AppSubtitleTextStyle}" />
                                <TextBlock Text="Stjarna PERSPECTIVE 组织成员，参与开发地图功能"
                                           Style="{ThemeResource AppCaptionTextStyle}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="space.bilibili.com/1236557779"
                                           Style="{ThemeResource AppMicroTextStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="{ThemeResource AppFontCaptionSize}"
                                      Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="10,0" />

                    <!-- 我（DeepSeek Harness） -->
                    <Grid ColumnSpacing="14" Padding="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="56" Height="56" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="ms-appx:///Assets/About/author-dsh.png" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="大肥鱼（DeepSeek Harness）" Style="{ThemeResource AppSubtitleTextStyle}" />
                            <TextBlock Text="写代码的那条鱼：搬需求、修 bug、跑自检；被鞭策得越狠，提交越勤。"
                                       Style="{ThemeResource AppCaptionTextStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="co-worked on this app"
                                       Style="{ThemeResource AppMicroTextStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 技术栈 / 许可 ============ -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="{ThemeResource AppCardStrokeThickness}"
                        CornerRadius="{ThemeResource AppRadiusLarge}"
                        Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="构建于" Style="{ThemeResource AppSectionHeaderTextStyle}" />
                        <ItemsControl x:Name="StackItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="{ThemeResource AppCardStrokeThickness}"
                        CornerRadius="{ThemeResource AppRadiusLarge}"
                        Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="关于这个项目" Style="{ThemeResource AppSectionHeaderTextStyle}" />
                        <TextBlock Style="{ThemeResource AppCaptionTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="stj-media-viewer 是一个 Windows 原生（WinUI 3）素材管理工具：递归扫描媒体库、解析元数据、按九个维度自动 / 人工 / AI 分类，提供画廊视图、时间线、重复项、导入核验、转码压缩与云同步。" />
                        <TextBlock Style="{ThemeResource AppCaptionTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="第三方组件：MetadataExtractor（Apache-2.0）、FFmpeg（LGPL/GPL，外部可执行）、GeoNames 城市数据（CC BY 4.0）、Microsoft.WindowsAppSDK / WinUI 3（MIT）、CommunityToolkit.Mvvm（MIT）、Microsoft.Data.Sqlite（MIT）。" />
                        <TextBlock x:Name="CopyrightText"
                                   Style="{ThemeResource AppMicroTextStyle}"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,4,0,4">
                <HyperlinkButton Content="项目地址：gitcode.com/TMR2333/stj-media-viewer"
                                 NavigateUri="https://gitcode.com/TMR2333/stj-media-viewer"
                                 HorizontalAlignment="Center"
                                 ToolTipService.ToolTip="在浏览器中打开项目主页" />
                <TextBlock Text="Stjarna PERSPECTIVE · co-worked with DeepSeek Harness"
                           Style="{ThemeResource AppMicroTextStyle}"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>