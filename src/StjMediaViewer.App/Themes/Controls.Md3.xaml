<?xml version="1.0" encoding="utf-8"?>
<!--
    Controls.Md3.xaml —— Material Design 3 结构性差异（控件词典）
    ================================================================
    能用 token 表达的差异（颜色/圆角/密度/字号）在 Tokens.Md3.xaml 里；
    这里只放 token 表达不了的结构差异：
      · 按钮 = MD3 filled tonal pill（999 全圆角 + 8%/12% state layer overlay）
      · 筛选胶囊 = FilterChip（选中态用主色 12% 容器 + 主色描边）
      · 文字 = MD3 type scale（display/title 用 Regular，subtitle/label 用 Medium）
    注意：所有颜色仍走 token，零透明（MD3 的规矩：靠色调表面分层，不靠模糊）。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =================================================================================
         按钮基座：胶囊 + 状态层（MD3 的 state layer，就是这一层 8%/12% 的 overlay）
         所有 MD3 按钮样式都 BasedOn 它，只改背景/前景/尺寸。
    ================================================================================= -->
    <Style x:Key="AppMd3PillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusPill}" />
        <Setter Property="Padding" Value="{ThemeResource AppControlPadding}" />
        <Setter Property="MinHeight" Value="{ThemeResource AppControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontBodySize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="HoverLayer" Background="{ThemeResource AppHoverBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="PressLayer" Background="{ThemeResource AppPressedBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="FocusLayer" BorderBrush="{ThemeResource AppFocusRingBrush}"
                                BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Presenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="0" />
                                        <Setter Target="PressLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 默认按钮（没有显式 Style 的 Button）= MD3 filled button -->
    <Style TargetType="Button" BasedOn="{StaticResource AppMd3PillButtonStyle}" />

    <!-- 次级按钮 = MD3 tonal button（secondary container 底 + on-secondary-container 文字） -->
    <Style x:Key="AppSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource AppMd3PillButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AppSelectedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <!-- 图标按钮 = 圆形 text button，无底色 -->
    <Style x:Key="AppIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppMd3PillButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AppTransparentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="{ThemeResource AppControlHeightSmall}" />
        <Setter Property="MinHeight" Value="{ThemeResource AppControlHeightSmall}" />
        <Setter Property="FontFamily" Value="{ThemeResource AppIconFontFamily}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- =================================================================================
         筛选胶囊 = MD3 FilterChip：Unchecked 是 outline-variant 描边胶囊，Checked 是 secondary container（无描边）。
    ================================================================================= -->
    <Style x:Key="AppChipStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource AppTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusPill}" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="MinHeight" Value="{ThemeResource AppControlHeightSmall}" />
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontCaptionSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <!-- MD3 FilterChip 选中态 = secondary container（无描边，靠色调分层） -->
                        <Border x:Name="CheckedLayer" Background="{ThemeResource AppSelectedBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="HoverLayer" Background="{ThemeResource AppHoverBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="PressLayer" Background="{ThemeResource AppPressedBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Presenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontSize="{TemplateBinding FontSize}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PressLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckedLayer.Opacity" Value="0" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckedLayer.Opacity" Value="1" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate">
                                    <VisualState.Setters>
                                        <Setter Target="CheckedLayer.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================================
         MD3 字阶：display / title = Regular(400)，subtitle / label = Medium(500)
         （WinUI 默认是 SemiBold，这是 MD3 与 Fluent 一眼能看出来的排版差异）
    ================================================================================= -->
    <Style x:Key="AppDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontDisplaySize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="AppTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontTitleSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="AppSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontSubtitleSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="AppSectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontCaptionSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

</ResourceDictionary>