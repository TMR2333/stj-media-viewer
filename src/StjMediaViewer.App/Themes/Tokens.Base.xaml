<?xml version="1.0" encoding="utf-8"?>
<!--
    Tokens.Base.xaml —— 设计语言 token 契约层
    ================================================================
    1) 这里是"键必须存在"的兜底定义：任何皮肤（Fluent / MD3 / Liquid Glass）
       都会在运行时以同名键覆盖它，App 代码只认键，不认具体颜色。
    2) 所有界面颜色/圆角/字号/动效必须走 token；禁止在页面里硬编码颜色。
    3) 维度正交：外层 MergedDictionaries 切"设计语言"，内层 ThemeDictionaries 切"明暗"。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StjMediaViewer.App.Controls">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ===================== 深色（默认） ===================== -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FF1A1A1C" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF202024" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#FF27272C" />
            <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#FF2D2D33" />
            <SolidColorBrush x:Key="AppSurfaceOverlayBrush" Color="#F22A2A30" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="AppStrokeBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="AppHoverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="AppPressedBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="AppSelectedBrush" Color="#2660CDFF" />
            <SolidColorBrush x:Key="AppSelectedBorderBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="AppFocusRingBrush" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FF00212F" />

            <SolidColorBrush x:Key="AccentBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF75D4FF" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF4FB8E8" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F60CDFF" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#4D60CDFF" />

            <SolidColorBrush x:Key="DangerBrush" Color="#FFFF99A4" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1FFF99A4" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFFCE100" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#1FFCE100" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1F6CCB5F" />
            <SolidColorBrush x:Key="InfoBrush" Color="#FF60CDFF" />

            <SolidColorBrush x:Key="BadgeRawBrush" Color="#FF8A5A00" />
            <SolidColorBrush x:Key="BadgeRawTextBrush" Color="#FFFFE0A3" />
            <SolidColorBrush x:Key="BadgeLogBrush" Color="#FF533B96" />
            <SolidColorBrush x:Key="BadgeLogTextBrush" Color="#FFDDD1FF" />
            <SolidColorBrush x:Key="BadgeVideoBrush" Color="#FF134A6B" />
            <SolidColorBrush x:Key="BadgeVideoTextBrush" Color="#FFA9DBFF" />
            <SolidColorBrush x:Key="BadgeImageBrush" Color="#FF1F4E28" />
            <SolidColorBrush x:Key="BadgeImageTextBrush" Color="#FFB7E8BF" />
            <SolidColorBrush x:Key="BadgeAudioBrush" Color="#FF6B2E4A" />
            <SolidColorBrush x:Key="BadgeAudioTextBrush" Color="#FFFFC2DC" />
            <SolidColorBrush x:Key="BadgeAiBrush" Color="#FF3B2F6B" />
            <SolidColorBrush x:Key="BadgeAiTextBrush" Color="#FFD5CBFF" />

            <SolidColorBrush x:Key="AppGlassTintBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppGlassStrokeBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppGlassHighlightBrush" Color="#00FFFFFF" />
            <!-- 玻璃镜面 sheen / 内阴影（Fluent/MD3 全透明 → 自动退化） -->
            <SolidColorBrush x:Key="AppGlassSheenBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppGlassInnerShadowBrush" Color="#00FFFFFF" />
            <!-- 环境光场：AmbientBackdrop 用；只有 Glass 皮肤明显，其余皮肤透明 -->
            <SolidColorBrush x:Key="AppAmbientBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppAmbientGlowBlueBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppAmbientGlowVioletBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppAmbientGlowTealBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppAmbientGlowWarmBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppAmbientVignetteBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="AppScrimBrush" Color="#B3000000" />
            <!-- 结构色：透明占位。不允许在页面里直接写 Colors.Transparent，统一走它 -->
            <SolidColorBrush x:Key="AppTransparentBrush" Color="#00000000" />
        </ResourceDictionary>

        <!-- ===================== 浅色 ===================== -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#FFF7F7F9" />
            <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceOverlayBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#14000000" />
            <SolidColorBrush x:Key="AppStrokeBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="AppHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="AppPressedBrush" Color="#14000000" />
            <SolidColorBrush x:Key="AppSelectedBrush" Color="#260078D4" />
            <SolidColorBrush x:Key="AppSelectedBorderBrush" Color="#FF0078D4" />
            <SolidColorBrush x:Key="AppFocusRingBrush" Color="#FF000000" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#73000000" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF106EBE" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF005A9E" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F0078D4" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#4D0078D4" />

            <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1FC42B1C" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9D5D00" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#1F9D5D00" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF0F7B0F" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1F0F7B0F" />
            <SolidColorBrush x:Key="InfoBrush" Color="#FF0078D4" />

            <SolidColorBrush x:Key="BadgeRawBrush" Color="#FFF7E3B8" />
            <SolidColorBrush x:Key="BadgeRawTextBrush" Color="#FF6B4300" />
            <SolidColorBrush x:Key="BadgeLogBrush" Color="#FFE4DCFF" />
            <SolidColorBrush x:Key="BadgeLogTextBrush" Color="#FF3D2B7A" />
            <SolidColorBrush x:Key="BadgeVideoBrush" Color="#FFD6E9F7" />
            <SolidColorBrush x:Key="BadgeVideoTextBrush" Color="#FF0B4A73" />
            <SolidColorBrush x:Key="BadgeImageBrush" Color="#FFDAF0DD" />
            <SolidColorBrush x:Key="BadgeImageTextBrush" Color="#FF1C5A28" />
            <SolidColorBrush x:Key="BadgeAudioBrush" Color="#FFFADDE9" />
            <SolidColorBrush x:Key="BadgeAudioTextBrush" Color="#FF7A2350" />
            <SolidColorBrush x:Key="BadgeAiBrush" Color="#FFEDE6FF" />
            <SolidColorBrush x:Key="BadgeAiTextBrush" Color="#FF4A2E9E" />

            <SolidColorBrush x:Key="AppGlassTintBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppGlassStrokeBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppGlassHighlightBrush" Color="#00FFFFFF" />
            <!-- 玻璃镜面 sheen / 内阴影（Fluent/MD3 全透明 → 自动退化） -->
            <SolidColorBrush x:Key="AppGlassSheenBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppGlassInnerShadowBrush" Color="#00FFFFFF" />
            <!-- 环境光场：AmbientBackdrop 用；只有 Glass 皮肤明显，其余皮肤透明 -->
            <SolidColorBrush x:Key="AppAmbientBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppAmbientGlowBlueBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppAmbientGlowVioletBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppAmbientGlowTealBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppAmbientGlowWarmBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppAmbientVignetteBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="AppScrimBrush" Color="#8C000000" />
            <!-- 结构色：透明占位。不允许在页面里直接写 Colors.Transparent，统一走它 -->
            <SolidColorBrush x:Key="AppTransparentBrush" Color="#00000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===================== 几何 / 尺寸 ===================== -->
    <CornerRadius x:Key="AppRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="AppRadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="AppRadiusLarge">10</CornerRadius>
    <CornerRadius x:Key="AppRadiusXLarge">14</CornerRadius>
    <CornerRadius x:Key="AppRadiusPill">4</CornerRadius>
    <!-- 仅用于真正的圆点（颜色标签点 / 状态点 / 评分点），不要拿来做胶囊按钮 -->
    <CornerRadius x:Key="AppRadiusCircle">999</CornerRadius>
    <CornerRadius x:Key="AppCardRadius">8</CornerRadius>

    <x:Double x:Key="AppControlHeight">36</x:Double>
    <x:Double x:Key="AppControlHeightSmall">28</x:Double>
    <x:Double x:Key="AppControlHeightLarge">44</x:Double>
    <x:Double x:Key="AppCardStrokeThickness">1</x:Double>
    <!-- 玻璃镜面描边：Glass 皮肤升到 1.5px，其余皮肤保持 1px（描边色透明，自动退化） -->
    <x:Double x:Key="AppGlassStrokeThickness">1</x:Double>
    <x:Double x:Key="AppGap">8</x:Double>
    <x:Double x:Key="AppGapLarge">16</x:Double>
    <x:Double x:Key="AppCardElevation">8</x:Double>
    <x:Double x:Key="AppDividerThickness">1</x:Double>
    <!-- 玻璃外阴影：>0 时 GlassPanel/SectionCard 才会挂 ThemeShadow（Fluent/MD3 = 0，不挂阴影） -->
    <x:Double x:Key="AppGlassShadowOpacity">0</x:Double>
    <x:Double x:Key="AppGlassShadowDepth">0</x:Double>

    <Thickness x:Key="AppPagePadding">24,18,24,18</Thickness>
    <Thickness x:Key="AppCardPadding">12</Thickness>
    <Thickness x:Key="AppControlPadding">12,0,12,0</Thickness>
    <Thickness x:Key="AppPanePadding">16,12,16,12</Thickness>

    <!-- ===================== 字体 / 字阶 ===================== -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Cascadia Mono</FontFamily>
    <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons</FontFamily>

    <x:Double x:Key="AppFontDisplaySize">32</x:Double>
    <x:Double x:Key="AppFontTitleSize">24</x:Double>
    <x:Double x:Key="AppFontSubtitleSize">17</x:Double>
    <x:Double x:Key="AppFontBodySize">14</x:Double>
    <x:Double x:Key="AppFontCaptionSize">12</x:Double>
    <x:Double x:Key="AppFontMicroSize">11</x:Double>

    <!-- ===================== 动效 ===================== -->
    <x:Double x:Key="AppMotionFastMs">120</x:Double>
    <x:Double x:Key="AppMotionStandardMs">240</x:Double>
    <x:Double x:Key="AppMotionEmphasizedMs">380</x:Double>

    <!-- ===================== 文本样式 ===================== -->
    <Style x:Key="AppDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontDisplaySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="AppTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="AppSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontSubtitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="AppBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontBodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontCaptionSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="AppMicroTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontMicroSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="AppSectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontCaptionSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <!-- ===================== 容器样式 ===================== -->
    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource AppCardStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppCardRadius}" />
        <Setter Property="Padding" Value="{ThemeResource AppCardPadding}" />
    </Style>

    <Style x:Key="AppPaneStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="{ThemeResource AppPanePadding}" />
    </Style>

    <!-- ===================== 控件样式 ===================== -->
    <Style x:Key="AppIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="{ThemeResource AppControlHeightSmall}" />
        <Setter Property="MinHeight" Value="{ThemeResource AppControlHeightSmall}" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusMedium}" />
        <Setter Property="FontFamily" Value="{ThemeResource AppIconFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="AppChipStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusPill}" />
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontCaptionSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="AppSubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusMedium}" />
        <Setter Property="Padding" Value="{ThemeResource AppControlPadding}" />
        <Setter Property="MinHeight" Value="{ThemeResource AppControlHeight}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontBodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <!-- ===================== 分隔线 ===================== -->
    <Style x:Key="AppDividerLineStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource AppDividerBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- =================================================================================
         自定义容器控件默认样式（ui-shell 维护）
         =================================================================================
         放在 Tokens.Base.xaml 而不是 Themes/Generic.xaml：App.xaml 只合并 Tokens.Base.xaml，
         而 ui-views 的页面可能在 ApplySavedAsync 之前创建，控件必须始终有兜底模板。
         模板全部只引用 token，因此三套皮肤自动变形：
         · Fluent / MD3：AppGlass* 全透明 → GlassPanel 退化成普通卡片（用 AppCardStrokeBrush 的细描边）；
         · Glass：底座 → 玻璃 tint → 45° sheen → 顶部渐变高光 → 底部内阴影 → 柔和外阴影（ThemeShadow）。
         光源永远左上：高光在顶部、内阴影在底部、sheen 从左上斜向右下。
    ================================================================================= -->
    <Style TargetType="controls:GlassPanel">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ContentPadding" Value="{ThemeResource AppCardPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassPanel">
                    <Grid x:Name="ShadowHost">
                        <!-- 层 1：底座（Glass 下是更深的一层，制造"背景层/卡片层"的深度差） -->
                        <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                                BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                CornerRadius="{ThemeResource AppCardRadius}" />
                        <!-- 层 2：玻璃 tint（玻璃厚度的一半来自这一层） -->
                        <Border Background="{ThemeResource AppGlassTintBrush}"
                                CornerRadius="{ThemeResource AppCardRadius}" />
                        <!-- 层 3：45° 镜面 sheen（左上→右下，统一光源；不是实心白边） -->
                        <Border Background="{ThemeResource AppGlassSheenBrush}"
                                CornerRadius="{ThemeResource AppCardRadius}" />
                        <!-- 层 4：顶部渐变高光（峰值 50% 白，两端透明） -->
                        <Border Height="1" VerticalAlignment="Top" Margin="20,1,20,0"
                                Background="{ThemeResource AppGlassHighlightBrush}" />
                        <!-- 层 5：底部内阴影（inset shadow 的替代，给"厚度"） -->
                        <Border Height="1" VerticalAlignment="Bottom" Margin="20,0,20,1"
                                Background="{ThemeResource AppGlassInnerShadowBrush}" />
                        <Border Padding="{TemplateBinding ContentPadding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SectionCard">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SectionCard">
                    <Grid x:Name="ShadowHost">
                        <Border Background="{ThemeResource AppSurfaceRaisedBrush}"
                                BorderBrush="{ThemeResource AppCardStrokeBrush}"
                                BorderThickness="{ThemeResource AppCardStrokeThickness}"
                                CornerRadius="{ThemeResource AppCardRadius}" />
                        <Border Background="{ThemeResource AppGlassTintBrush}"
                                CornerRadius="{ThemeResource AppCardRadius}" />
                        <Border Background="{ThemeResource AppGlassSheenBrush}"
                                CornerRadius="{ThemeResource AppCardRadius}" />
                        <Border Height="1" VerticalAlignment="Top" Margin="22,1,22,0"
                                Background="{ThemeResource AppGlassHighlightBrush}" />
                        <Border Height="1" VerticalAlignment="Bottom" Margin="22,0,22,1"
                                Background="{ThemeResource AppGlassInnerShadowBrush}" />
                        <Border Padding="{ThemeResource AppCardPadding}">
                            <Grid RowSpacing="{ThemeResource AppGap}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="HeaderPanel" Grid.Row="0" Orientation="Horizontal"
                                            Spacing="{ThemeResource AppGap}" VerticalAlignment="Center">
                                    <FontIcon x:Name="HeaderIcon" Glyph="{TemplateBinding Glyph}" FontSize="16"
                                              Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderText" Text="{TemplateBinding Header}"
                                                   Style="{ThemeResource AppSubtitleTextStyle}" />
                                        <TextBlock x:Name="SubtitleText" Text="{TemplateBinding Subtitle}"
                                                   Style="{ThemeResource AppCaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                                <Border x:Name="HeaderDivider" Grid.Row="1" Height="1"
                                        Background="{ThemeResource AppDividerBrush}" />
                                <ContentPresenter Grid.Row="2" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>