<?xml version="1.0" encoding="utf-8"?>
<!--
    Controls.Glass.xaml —— Apple Liquid Glass 结构性差异（控件词典）
    ================================================================
    Apple 的规矩：
      1) 玻璃只包"控件与导航"，内容区不透明 —— 所以 content 用 AppSurface*，控件用 AppGlass*；
      2) 玻璃 = 半透明 tint + 1.5px 镜面描边 + 顶部高光（specular），不是简单的灰色矩形；
      3) 大圆角、更松的留白、字号更大、状态反馈更"弹"（按下时压暗、hover 时提亮）。
    能用 token 表达的（半径/密度/字号/颜色）在 Tokens.Glass.xaml；这里只放模板结构。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =================================================================================
         按钮基座：玻璃（tint + 45° sheen + 渐变高光 + 底部内阴影 + hover 提亮 / press 压暗）
         注意：用渐变高光代替"1px 实心白边"——实心白边是廉价玻璃感的主要来源。
    ================================================================================= -->
    <Style x:Key="AppGlassButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppGlassTintBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <!-- 只用极细的低对比描边定义轮廓；"玻璃感"来自渐变高光和 sheen -->
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusMedium}" />
        <Setter Property="Padding" Value="{ThemeResource AppControlPadding}" />
        <Setter Property="MinHeight" Value="{ThemeResource AppControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontBodySize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <!-- 45° sheen：统一光源永远左上 -->
                        <Border x:Name="Sheen" Background="{ThemeResource AppGlassSheenBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <!-- 顶部渐变高光（峰值约 50% 白，两端透明） -->
                        <Border x:Name="Highlight" Height="1" VerticalAlignment="Top"
                                Margin="12,1,12,0" Background="{ThemeResource AppGlassHighlightBrush}" />
                        <!-- 底部内阴影：替代 CSS inset shadow，给"厚度" -->
                        <Border x:Name="InnerShadow" Height="1" VerticalAlignment="Bottom"
                                Margin="12,0,12,1" Background="{ThemeResource AppGlassInnerShadowBrush}" />
                        <Border x:Name="HoverLayer" Background="{ThemeResource AppGlassSheenBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="PressLayer" Background="{ThemeResource AppPressedBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="FocusLayer" BorderBrush="{ThemeResource AppFocusRingBrush}"
                                BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Presenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="0" />
                                        <Setter Target="PressLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 默认按钮 = 玻璃按钮 -->
    <Style TargetType="Button" BasedOn="{StaticResource AppGlassButtonStyle}" />

    <!-- 次级按钮 = 主色 tint 玻璃（Apple 的 tinted glass） -->
    <Style x:Key="AppSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource AppGlassButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentBorderBrush}" />
    </Style>

    <!-- 图标按钮 = 圆形玻璃按钮 -->
    <Style x:Key="AppIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppGlassButtonStyle}">
        <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusPill}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="{ThemeResource AppControlHeightSmall}" />
        <Setter Property="MinHeight" Value="{ThemeResource AppControlHeightSmall}" />
        <Setter Property="FontFamily" Value="{ThemeResource AppIconFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <!-- 筛选胶囊 = 玻璃胶囊，选中态用主色 tint 玻璃 -->
    <Style x:Key="AppChipStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource AppGlassTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppRadiusPill}" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="MinHeight" Value="{ThemeResource AppControlHeightSmall}" />
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontCaptionSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="CheckedLayer" Background="{ThemeResource AccentSubtleBrush}"
                                BorderBrush="{ThemeResource AccentBorderBrush}" BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="Sheen" Background="{ThemeResource AppGlassSheenBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="Highlight" Height="1" VerticalAlignment="Top"
                                Margin="12,1,12,0" Background="{ThemeResource AppGlassHighlightBrush}" />
                        <Border x:Name="InnerShadow" Height="1" VerticalAlignment="Bottom"
                                Margin="12,0,12,1" Background="{ThemeResource AppGlassInnerShadowBrush}" />
                        <Border x:Name="HoverLayer" Background="{ThemeResource AppGlassSheenBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="PressLayer" Background="{ThemeResource AppPressedBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Presenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontSize="{TemplateBinding FontSize}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="0" />
                                        <Setter Target="PressLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckedLayer.Opacity" Value="0" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckedLayer.Opacity" Value="1" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate">
                                    <VisualState.Setters>
                                        <Setter Target="CheckedLayer.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================================
         Apple 字阶：display Bold、title SemiBold，正文用 Medium 提升小字号可读性
    ================================================================================= -->
    <Style x:Key="AppDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontDisplaySize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="AppTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="AppSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontSubtitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="AppBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource AppFontBodySize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>