<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StjMediaViewer.App.Controls.RatingStars"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 五颗星：每颗都是"实心 + 空心"两层，代码只切 Visibility，
         颜色全部由 XAML 里的 ThemeResource 提供 —— 这样明暗主题切换时能自动重解析。 -->
    <StackPanel x:Name="StarsPanel" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button x:Name="Star0" Style="{ThemeResource AppIconButtonStyle}" Padding="2" MinWidth="24" MinHeight="24">
            <Grid>
                <FontIcon Glyph="&#xE735;" FontSize="{ThemeResource AppFontSubtitleSize}" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" />
                <FontIcon Glyph="&#xE734;" FontSize="{ThemeResource AppFontSubtitleSize}" Foreground="{ThemeResource TextTertiaryBrush}" />
            </Grid>
        </Button>
        <Button x:Name="Star1" Style="{ThemeResource AppIconButtonStyle}" Padding="2" MinWidth="24" MinHeight="24">
            <Grid>
                <FontIcon Glyph="&#xE735;" FontSize="{ThemeResource AppFontSubtitleSize}" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" />
                <FontIcon Glyph="&#xE734;" FontSize="{ThemeResource AppFontSubtitleSize}" Foreground="{ThemeResource TextTertiaryBrush}" />
            </Grid>
        </Button>
        <Button x:Name="Star2" Style="{ThemeResource AppIconButtonStyle}" Padding="2" MinWidth="24" MinHeight="24">
            <Grid>
                <FontIcon Glyph="&#xE735;" FontSize="{ThemeResource AppFontSubtitleSize}" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" />
                <FontIcon Glyph="&#xE734;" FontSize="{ThemeResource AppFontSubtitleSize}" Foreground="{ThemeResource TextTertiaryBrush}" />
            </Grid>
        </Button>
        <Button x:Name="Star3" Style="{ThemeResource AppIconButtonStyle}" Padding="2" MinWidth="24" MinHeight="24">
            <Grid>
                <FontIcon Glyph="&#xE735;" FontSize="{ThemeResource AppFontSubtitleSize}" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" />
                <FontIcon Glyph="&#xE734;" FontSize="{ThemeResource AppFontSubtitleSize}" Foreground="{ThemeResource TextTertiaryBrush}" />
            </Grid>
        </Button>
        <Button x:Name="Star4" Style="{ThemeResource AppIconButtonStyle}" Padding="2" MinWidth="24" MinHeight="24">
            <Grid>
                <FontIcon Glyph="&#xE735;" FontSize="{ThemeResource AppFontSubtitleSize}" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" />
                <FontIcon Glyph="&#xE734;" FontSize="{ThemeResource AppFontSubtitleSize}" Foreground="{ThemeResource TextTertiaryBrush}" />
            </Grid>
        </Button>
    </StackPanel>
</UserControl>