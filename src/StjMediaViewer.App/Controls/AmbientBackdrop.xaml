<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StjMediaViewer.App.Controls.AmbientBackdrop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <!--
        应用内"背景光场"：Liquid Glass 的地基。
        放在 ShellPage 根 Grid 的最底层（Stretch，IsHitTestVisible=False），
        叠 6 层：
          1) AppAmbientBrush         —— 150° 底色渐变（Glass: 深蓝黑/淡蓝紫；Fluent/MD3: 透明）
          2) AppAmbientGlowBlueBrush —— 左上蓝色光斑
          3) AppAmbientGlowVioletBrush —— 右上紫色光斑
          4) AppAmbientGlowTealBrush —— 右下青色光斑
          5) AppAmbientGlowWarmBrush —— 左下暖橙光斑
          6) AppAmbientVignetteBrush —— 四周压暗（给玻璃外阴影一个可落的地方）
        颜色/强度全部来自 token：只有 Glass 皮肤下才明显，另外两套皮肤全透明（自动退化）。
    -->
    <Grid>
        <Border Background="{ThemeResource AppAmbientBrush}" />
        <Border Background="{ThemeResource AppAmbientGlowBlueBrush}" />
        <Border Background="{ThemeResource AppAmbientGlowVioletBrush}" />
        <Border Background="{ThemeResource AppAmbientGlowTealBrush}" />
        <Border Background="{ThemeResource AppAmbientGlowWarmBrush}" />
        <Border Background="{ThemeResource AppAmbientVignetteBrush}" />
    </Grid>
</UserControl>