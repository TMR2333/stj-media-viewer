<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StjMediaViewer.App.Controls.FacetChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 胶囊本体用 token 样式：Fluent = 36px 圆角胶囊，MD3 = FilterChip（选中主色 12% 容器），
         Glass = 玻璃胶囊。三套皮肤由 AppChipStyle 的覆盖自动切换，不需要在这里判断。 -->
    <ToggleButton x:Name="ChipToggle"
                  Style="{ThemeResource AppChipStyle}"
                  Checked="ChipToggle_Checked"
                  Unchecked="ChipToggle_Unchecked"
                  HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock x:Name="LabelText" VerticalAlignment="Center" />
            <Border x:Name="CountBadge"
                    Background="{ThemeResource AppSelectedBrush}"
                    CornerRadius="{ThemeResource AppRadiusPill}"
                    Padding="6,0,6,0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="CountText" Style="{ThemeResource AppMicroTextStyle}" />
            </Border>
        </StackPanel>
    </ToggleButton>
</UserControl>