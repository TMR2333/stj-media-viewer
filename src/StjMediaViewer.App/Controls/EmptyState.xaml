<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StjMediaViewer.App.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel x:Name="RootPanel" MaxWidth="380" Spacing="10"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="{ThemeResource AppPagePadding}">
        <FontIcon x:Name="StateGlyph" FontSize="40" Foreground="{ThemeResource TextTertiaryBrush}"
                  HorizontalAlignment="Center" />
        <TextBlock x:Name="TitleText" Style="{ThemeResource AppSubtitleTextStyle}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="DescriptionText" Style="{ThemeResource AppBodyTextStyle}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="ActionButton" Style="{ThemeResource AppSubtleButtonStyle}"
                HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"
                Click="ActionButton_Click" />
    </StackPanel>
</UserControl>